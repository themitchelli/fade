# Describe top-level directories
describe_directories() {
    local dir="${1:-.}"

    # List top-level directories
    for entry in "$dir"/*/; do
        [[ -d "$entry" ]] || continue
        local name
        name=$(basename "$entry")

        # Skip hidden directories except .github
        if [[ "$name" == .* ]] && [[ "$name" != ".github" ]]; then
            continue
        fi

        # Skip excluded directories (uses default excludes + gitignore)
        if should_exclude_path "$name"; then
            continue
        fi

        local desc
        desc=$(get_dir_description "$name")
        if [[ -n "$desc" ]]; then
            echo "$name/ - $desc"
        else
            echo "$name/"
        fi
    done
}

# Detect architectural patterns from directory structure
detect_architecture_patterns() {
    local dir="${1:-.}"
    local patterns=()
    local confidences=()

    # -------------------------------------------------------------------------
    # MVC / MVVM Pattern Detection
    # -------------------------------------------------------------------------
    local mvc_count=0
    local mvc_dirs=""

    # Check for models
    if [[ -d "$dir/models" ]] || [[ -d "$dir/src/models" ]] || [[ -d "$dir/app/models" ]]; then
        ((mvc_count++))
        mvc_dirs+="models "
    fi

    # Check for views
    if [[ -d "$dir/views" ]] || [[ -d "$dir/src/views" ]] || [[ -d "$dir/app/views" ]]; then
        ((mvc_count++))
        mvc_dirs+="views "
    fi

    # Check for controllers
    if [[ -d "$dir/controllers" ]] || [[ -d "$dir/src/controllers" ]] || [[ -d "$dir/app/controllers" ]]; then
        ((mvc_count++))
        mvc_dirs+="controllers "
    fi

    # Check for viewmodels (MVVM)
    if [[ -d "$dir/viewmodels" ]] || [[ -d "$dir/src/viewmodels" ]] || [[ -d "$dir/view-models" ]]; then
        patterns+=("MVVM|certain|viewmodels/")
    elif [[ $mvc_count -eq 3 ]]; then
        patterns+=("MVC|certain|${mvc_dirs}")
    elif [[ $mvc_count -eq 2 ]]; then
        patterns+=("MVC|likely|${mvc_dirs}")
    elif [[ $mvc_count -eq 1 ]]; then
        patterns+=("MVC|possible|${mvc_dirs}")
    fi

    # -------------------------------------------------------------------------
    # API Structure Detection
    # -------------------------------------------------------------------------
    local api_dirs=""
    local api_confidence="possible"

    if [[ -d "$dir/routes" ]] || [[ -d "$dir/src/routes" ]] || [[ -d "$dir/app/routes" ]]; then
        api_dirs+="routes/ "
        api_confidence="certain"
    fi

    if [[ -d "$dir/api" ]] || [[ -d "$dir/src/api" ]] || [[ -d "$dir/app/api" ]]; then
        api_dirs+="api/ "
        api_confidence="certain"
    fi

    if [[ -d "$dir/endpoints" ]] || [[ -d "$dir/src/endpoints" ]]; then
        api_dirs+="endpoints/ "
        api_confidence="certain"
    fi

    if [[ -d "$dir/handlers" ]] || [[ -d "$dir/src/handlers" ]]; then
        api_dirs+="handlers/ "
        if [[ "$api_confidence" == "possible" ]]; then
            api_confidence="likely"
        fi
    fi

    if [[ -d "$dir/resources" ]] || [[ -d "$dir/src/resources" ]]; then
        api_dirs+="resources/ "
        if [[ "$api_confidence" == "possible" ]]; then
            api_confidence="likely"
        fi
    fi

    if [[ -n "$api_dirs" ]]; then
        patterns+=("API Routes|${api_confidence}|${api_dirs}")
    fi

    # -------------------------------------------------------------------------
    # Test Organization Detection
    # -------------------------------------------------------------------------
    local test_dirs=""
    local test_confidence="possible"

    if [[ -d "$dir/tests" ]] || [[ -d "$dir/test" ]]; then
        test_dirs+="tests/ "
        test_confidence="certain"
    fi

    if [[ -d "$dir/__tests__" ]] || [[ -d "$dir/src/__tests__" ]]; then
        test_dirs+="__tests__/ "
        test_confidence="certain"
    fi

    if [[ -d "$dir/spec" ]] || [[ -d "$dir/specs" ]]; then
        test_dirs+="spec/ "
        test_confidence="certain"
    fi

    # Check for colocated tests (*.test.ts, *.spec.js pattern)
    # Filter using should_exclude_path for consistency with gitignore
    local colocated_count
    colocated_count=$(find "$dir" -type f \( -name "*.test.*" -o -name "*.spec.*" \) 2>/dev/null | \
        while read -r file; do
            local exclude=false
            local check_path="$file"
            while [[ "$check_path" != "." && "$check_path" != "/" ]]; do
                local component
                component=$(basename "$check_path")
                if should_exclude_path "$component"; then
                    exclude=true
                    break
                fi
                check_path=$(dirname "$check_path")
            done
            [[ "$exclude" == false ]] && echo "$file"
        done | head -20 | wc -l | tr -d ' ')

    if [[ "$colocated_count" -gt 5 ]]; then
        test_dirs+="colocated "
        if [[ "$test_confidence" == "possible" ]]; then
            test_confidence="likely"
        fi
    fi

    if [[ -n "$test_dirs" ]]; then
        patterns+=("Test Organization|${test_confidence}|${test_dirs}")
    fi

    # -------------------------------------------------------------------------
    # Config Pattern Detection
    # -------------------------------------------------------------------------
    local config_items=""
    local config_confidence="possible"

    if [[ -d "$dir/config" ]] || [[ -d "$dir/configs" ]] || [[ -d "$dir/src/config" ]]; then
        config_items+="config/ "
        config_confidence="certain"
    fi

    if [[ -d "$dir/settings" ]] || [[ -d "$dir/src/settings" ]]; then
        config_items+="settings/ "
        config_confidence="certain"
    fi

    # Check for .env files
    local env_count
    env_count=$(find "$dir" -maxdepth 2 -name ".env*" -type f 2>/dev/null | wc -l | tr -d ' ')
    if [[ "$env_count" -gt 0 ]]; then
        config_items+=".env files "
        if [[ "$config_confidence" == "possible" ]]; then
            config_confidence="likely"
        fi
    fi

    # Check for config files in root
    if [[ -f "$dir/config.js" ]] || [[ -f "$dir/config.ts" ]] || [[ -f "$dir/config.json" ]] || \
       [[ -f "$dir/config.yaml" ]] || [[ -f "$dir/config.yml" ]] || [[ -f "$dir/settings.py" ]]; then
        config_items+="config files "
        if [[ "$config_confidence" == "possible" ]]; then
            config_confidence="likely"
        fi
    fi

    if [[ -n "$config_items" ]]; then
        patterns+=("Configuration|${config_confidence}|${config_items}")
    fi

    # -------------------------------------------------------------------------
    # Additional Common Patterns
    # -------------------------------------------------------------------------

    # Service Layer
    if [[ -d "$dir/services" ]] || [[ -d "$dir/src/services" ]] || [[ -d "$dir/app/services" ]]; then
        patterns+=("Service Layer|certain|services/")
    fi

    # Repository Pattern
    if [[ -d "$dir/repositories" ]] || [[ -d "$dir/src/repositories" ]] || [[ -d "$dir/repo" ]]; then
        patterns+=("Repository Pattern|certain|repositories/")
    fi

    # Domain-Driven Design
    local ddd_count=0
    [[ -d "$dir/domain" ]] || [[ -d "$dir/src/domain" ]] && ((ddd_count++))
    [[ -d "$dir/entities" ]] || [[ -d "$dir/src/entities" ]] && ((ddd_count++))
    [[ -d "$dir/aggregates" ]] || [[ -d "$dir/src/aggregates" ]] && ((ddd_count++))
    [[ -d "$dir/value-objects" ]] || [[ -d "$dir/src/value-objects" ]] && ((ddd_count++))

    if [[ $ddd_count -ge 2 ]]; then
        patterns+=("Domain-Driven Design|likely|domain/, entities/")
    elif [[ $ddd_count -eq 1 ]]; then
        patterns+=("Domain-Driven Design|possible|domain/")
    fi

    # Middleware Pattern
    if [[ -d "$dir/middleware" ]] || [[ -d "$dir/src/middleware" ]] || [[ -d "$dir/middlewares" ]]; then
        patterns+=("Middleware|certain|middleware/")
    fi

    # Component-Based (React/Vue/Angular)
    if [[ -d "$dir/components" ]] || [[ -d "$dir/src/components" ]]; then
        local component_confidence="certain"
        patterns+=("Component-Based UI|${component_confidence}|components/")
    fi

    # Feature-Based/Modular
    if [[ -d "$dir/features" ]] || [[ -d "$dir/src/features" ]] || [[ -d "$dir/modules" ]] || [[ -d "$dir/src/modules" ]]; then
        patterns+=("Feature/Module Based|certain|features/ or modules/")
    fi

    # Monorepo Detection
    if [[ -d "$dir/packages" ]] || [[ -d "$dir/apps" ]]; then
        if [[ -f "$dir/lerna.json" ]] || [[ -f "$dir/pnpm-workspace.yaml" ]] || [[ -f "$dir/turbo.json" ]]; then
            patterns+=("Monorepo|certain|packages/ or apps/")
        else
            patterns+=("Monorepo|likely|packages/ or apps/")
        fi
    fi

    # -------------------------------------------------------------------------
    # Output Results
    # -------------------------------------------------------------------------
    for pattern in "${patterns[@]}"; do
        echo "$pattern"
    done
}

# ============================================================================
# FRAGILE AREA DETECTION
# ============================================================================

# Detect potential fragile areas in the codebase
# Returns lines in format: path|reason|severity (high/medium/low)
# Helper function to filter find results using gitignore + default excludes
# Reads paths from stdin, outputs non-excluded paths to stdout
filter_excluded_paths() {
    while read -r path; do
        [[ -z "$path" ]] && continue
        local exclude=false
        local check_path="$path"
        while [[ "$check_path" != "." && "$check_path" != "/" ]]; do
            local component
            component=$(basename "$check_path")
            if should_exclude_path "$component"; then
                exclude=true
                break
            fi
            check_path=$(dirname "$check_path")
        done
        [[ "$exclude" == false ]] && echo "$path"
    done
}

detect_fragile_areas() {
    local dir="${1:-.}"
    local fragile_areas=()

    # -------------------------------------------------------------------------
    # Files over 500 lines (potentially complex)
    # -------------------------------------------------------------------------
    while IFS= read -r file; do
        if [[ -n "$file" ]]; then
            local lines
            lines=$(wc -l < "$file" 2>/dev/null | tr -d ' ')
            if [[ "$lines" -ge 500 ]]; then
                local rel_path
                rel_path="${file#$dir/}"
                if [[ "$lines" -ge 1000 ]]; then
                    fragile_areas+=("$rel_path|${lines} lines - very large file|high")
                else
                    fragile_areas+=("$rel_path|${lines} lines - large file|medium")
                fi
            fi
        fi
    done < <(find "$dir" -type f \( -name "*.js" -o -name "*.ts" -o -name "*.tsx" -o -name "*.jsx" -o -name "*.py" -o -name "*.go" -o -name "*.rs" -o -name "*.rb" -o -name "*.java" -o -name "*.php" -o -name "*.c" -o -name "*.cpp" -o -name "*.h" \) 2>/dev/null | filter_excluded_paths)

    # -------------------------------------------------------------------------
    # Directories with many files (>20) - potentially tangled
    # -------------------------------------------------------------------------
    while IFS= read -r subdir; do
        if [[ -n "$subdir" ]] && [[ -d "$subdir" ]]; then
            local file_count
            file_count=$(find "$subdir" -maxdepth 1 -type f \( -name "*.js" -o -name "*.ts" -o -name "*.tsx" -o -name "*.jsx" -o -name "*.py" -o -name "*.go" -o -name "*.rs" -o -name "*.rb" \) 2>/dev/null | wc -l | tr -d ' ')
            if [[ "$file_count" -gt 20 ]]; then
                local rel_path
                rel_path="${subdir#$dir/}"
                if [[ "$file_count" -gt 50 ]]; then
                    fragile_areas+=("$rel_path/|${file_count} files in one directory|high")
                else
                    fragile_areas+=("$rel_path/|${file_count} files in one directory|medium")
                fi
            fi
        fi
    done < <(find "$dir" -type d 2>/dev/null | filter_excluded_paths | head -100)

    # -------------------------------------------------------------------------
    # Files/directories with 'legacy', 'old', 'deprecated' in name
    # -------------------------------------------------------------------------
    while IFS= read -r item; do
        if [[ -n "$item" ]]; then
            local rel_path
            rel_path="${item#$dir/}"
            local basename
            basename=$(basename "$item" | tr '[:upper:]' '[:lower:]')
            local reason=""

            if [[ "$basename" == *legacy* ]]; then
                reason="legacy code"
            elif [[ "$basename" == *old* ]] || [[ "$basename" == *_old* ]] || [[ "$basename" == *-old* ]]; then
                reason="marked as old"
            elif [[ "$basename" == *deprecated* ]]; then
                reason="deprecated code"
            fi

            if [[ -n "$reason" ]]; then
                fragile_areas+=("$rel_path|$reason|medium")
            fi
        fi
    done < <(find "$dir" \( -type f -o -type d \) \( -iname "*legacy*" -o -iname "*_old*" -o -iname "*-old*" -o -iname "*deprecated*" \) 2>/dev/null | filter_excluded_paths | head -20)

    # -------------------------------------------------------------------------
    # Files with many TODO/FIXME/HACK comments
    # -------------------------------------------------------------------------
    while IFS= read -r file; do
        if [[ -n "$file" ]] && [[ -f "$file" ]]; then
            local comment_count
            # Use grep -c and tr to remove any whitespace, default to 0 if grep fails
            comment_count=$(grep -c -E '(TODO|FIXME|HACK|XXX|BUG):?' "$file" 2>/dev/null | tr -d '[:space:]' || true)
            # Ensure it's a number, default to 0 if empty
            [[ -z "$comment_count" ]] && comment_count=0
            if [[ "$comment_count" -ge 5 ]]; then
                local rel_path
                rel_path="${file#$dir/}"
                if [[ "$comment_count" -ge 10 ]]; then
                    fragile_areas+=("$rel_path|${comment_count} TODO/FIXME/HACK comments|high")
                else
                    fragile_areas+=("$rel_path|${comment_count} TODO/FIXME/HACK comments|medium")
                fi
            fi
        fi
    done < <(find "$dir" -type f \( -name "*.js" -o -name "*.ts" -o -name "*.tsx" -o -name "*.jsx" -o -name "*.py" -o -name "*.go" -o -name "*.rs" -o -name "*.rb" -o -name "*.java" -o -name "*.php" \) 2>/dev/null | filter_excluded_paths)

    # -------------------------------------------------------------------------
    # Output Results (deduplicated, sorted by severity)
    # -------------------------------------------------------------------------
    # High severity first, then medium, then low
    for area in "${fragile_areas[@]}"; do
        echo "$area"
    done | sort -t'|' -k3 -r | head -20
}

# ============================================================================
# DEPENDENCY ANALYSIS
# ============================================================================

# Categorize a dependency based on its name
# Returns: framework|database|testing|utilities|other
categorize_dependency() {
    local dep="$1"
    local dep_lower
    dep_lower=$(echo "$dep" | tr '[:upper:]' '[:lower:]')

    # Frameworks
    case "$dep_lower" in
        react|vue|angular|svelte|next|nuxt|gatsby|@angular/*|@nestjs/*|\
        express|fastify|koa|hapi|restify|\
        django|flask|fastapi|tornado|pyramid|bottle|starlette|\
        rails|sinatra|\
        actix-web|axum|rocket|warp|\
        gin|echo|fiber|chi|gorilla/*|\
        spring*|quarkus)
            echo "framework"
            return
            ;;
    esac

    # Database
    case "$dep_lower" in
        pg|postgres|postgresql|mysql|mysql2|sqlite|sqlite3|\
        mongodb|mongoose|redis|ioredis|\
        prisma|@prisma/*|drizzle*|sequelize|typeorm|knex|\
        sqlalchemy|alembic|peewee|tortoise-orm|\
        diesel|sqlx|sea-orm|\
        gorm|ent|\
        activerecord|mongoid)
            echo "database"
            return
            ;;
    esac

    # Testing
    case "$dep_lower" in
        jest|vitest|mocha|jasmine|chai|sinon|supertest|@testing-library/*|\
        pytest|unittest|nose|coverage|pytest-*|\
        rspec|minitest|\
        tokio-test|rstest|\
        testify|ginkgo|gomega)
            echo "testing"
            return
            ;;
    esac

    # Utilities (common ones)
    case "$dep_lower" in
        lodash|underscore|ramda|date-fns|moment|dayjs|\
        axios|got|node-fetch|superagent|\
        dotenv|cross-env|commander|yargs|chalk|ora|inquirer|\
        uuid|nanoid|bcrypt|jsonwebtoken|passport*|\
        winston|pino|bunyan|morgan|\
        zod|yup|joi|ajv|class-validator|\
        requests|httpx|click|typer|pydantic|python-dotenv|\
        serde|clap|tokio|reqwest|\
        cobra|viper|zap|logrus)
            echo "utilities"
            return
            ;;
    esac

    echo "other"
}

# Analyze dependencies from package.json
analyze_npm_dependencies() {
    local file="$1"

    if [[ ! -f "$file" ]]; then
        return
    fi

    local content
    content=$(cat "$file" 2>/dev/null)

    # Extract dependencies and devDependencies
    # Simple regex extraction - not perfect but works for most cases
    local in_deps=false
    local in_dev_deps=false
    local dep_name
    local dep_type

    while IFS= read -r line; do
        # Detect section boundaries
        if echo "$line" | grep -q '"dependencies"'; then
            in_deps=true
            in_dev_deps=false
            continue
        elif echo "$line" | grep -q '"devDependencies"'; then
            in_deps=false
            in_dev_deps=true
            continue
        elif echo "$line" | grep -q '"peerDependencies"\|"scripts"\|"name"\|"version"\|"main"'; then
            in_deps=false
            in_dev_deps=false
            continue
        fi

        # Extract dependency name (first quoted string before the colon)
        if $in_deps || $in_dev_deps; then
            # Match pattern like "package-name": and extract package-name
            dep_name=$(echo "$line" | sed -n 's/.*"\([^"]*\)"[[:space:]]*:.*/\1/p' | head -1)
            if [[ -n "$dep_name" ]] && [[ ! "$dep_name" =~ ^[0-9\^~] ]]; then
                local category
                category=$(categorize_dependency "$dep_name")
                if $in_dev_deps; then
                    dep_type="dev"
                else
                    dep_type="prod"
                fi
                echo "$dep_name|$category|$dep_type|npm"
            fi
        fi
    done <<< "$content"
}

# Analyze Python dependencies
analyze_python_dependencies() {
    local dir="$1"

    # Check requirements.txt
    if [[ -f "$dir/requirements.txt" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            # Skip comments and empty lines
            [[ "$line" =~ ^[[:space:]]*# ]] && continue
            [[ -z "$line" ]] && continue

            # Extract package name (before ==, >=, etc.)
            local dep_name
            dep_name=$(echo "$line" | sed 's/[=><!].*//' | sed 's/\[.*//' | tr -d '[:space:]')

            if [[ -n "$dep_name" ]]; then
                local category
                category=$(categorize_dependency "$dep_name")
                echo "$dep_name|$category|prod|pip"
            fi
        done < "$dir/requirements.txt"
    fi

    # Check requirements-dev.txt or dev-requirements.txt
    for dev_file in "$dir/requirements-dev.txt" "$dir/dev-requirements.txt" "$dir/requirements_dev.txt"; do
        if [[ -f "$dev_file" ]]; then
            while IFS= read -r line || [[ -n "$line" ]]; do
                [[ "$line" =~ ^[[:space:]]*# ]] && continue
                [[ -z "$line" ]] && continue

                local dep_name
                dep_name=$(echo "$line" | sed 's/[=><!].*//' | sed 's/\[.*//' | tr -d '[:space:]')

                if [[ -n "$dep_name" ]]; then
                    local category
                    category=$(categorize_dependency "$dep_name")
                    echo "$dep_name|$category|dev|pip"
                fi
            done < "$dev_file"
        fi
    done

    # Check pyproject.toml for dependencies
    if [[ -f "$dir/pyproject.toml" ]]; then
        local in_deps=false
        local in_dev_deps=false

        while IFS= read -r line || [[ -n "$line" ]]; do
            # Detect sections
            if echo "$line" | grep -q '^\[project\]$\|^\[tool.poetry\]$'; then
                continue
            elif echo "$line" | grep -q 'dependencies\s*=\s*\['; then
                in_deps=true
                in_dev_deps=false
                continue
            elif echo "$line" | grep -q 'dev-dependencies\|optional-dependencies'; then
                in_deps=false
                in_dev_deps=true
                continue
            elif echo "$line" | grep -q '^\['; then
                in_deps=false
                in_dev_deps=false
                continue
            fi

            if $in_deps || $in_dev_deps; then
                # Extract dependency from quotes
                local dep_name
                dep_name=$(echo "$line" | sed -n 's/.*"\([^">=<]*\).*/\1/p' | head -1)
                if [[ -n "$dep_name" ]] && [[ ! "$dep_name" =~ ^\[ ]]; then
                    local category
                    category=$(categorize_dependency "$dep_name")
                    if $in_dev_deps; then
                        echo "$dep_name|$category|dev|pip"
                    else
                        echo "$dep_name|$category|prod|pip"
                    fi
                fi
            fi
        done < "$dir/pyproject.toml"
    fi
}

# Analyze Rust dependencies from Cargo.toml
analyze_rust_dependencies() {
    local file="$1"

    if [[ ! -f "$file" ]]; then
        return
    fi

    local in_deps=false
    local in_dev_deps=false

    while IFS= read -r line || [[ -n "$line" ]]; do
        # Detect sections
        if echo "$line" | grep -q '^\[dependencies\]'; then
            in_deps=true
            in_dev_deps=false
            continue
        elif echo "$line" | grep -q '^\[dev-dependencies\]'; then
            in_deps=false
            in_dev_deps=true
            continue
        elif echo "$line" | grep -q '^\['; then
            in_deps=false
            in_dev_deps=false
            continue
        fi

        if $in_deps || $in_dev_deps; then
            # Extract dependency name (before = or .)
            local dep_name
            dep_name=$(echo "$line" | grep '=' | sed 's/[[:space:]]*=.*//' | tr -d '[:space:]')
            if [[ -n "$dep_name" ]]; then
                local category
                category=$(categorize_dependency "$dep_name")
                if $in_dev_deps; then
                    echo "$dep_name|$category|dev|cargo"
                else
                    echo "$dep_name|$category|prod|cargo"
                fi
            fi
        fi
    done < "$file"
}

# Analyze Go dependencies from go.mod
analyze_go_dependencies() {
    local file="$1"

    if [[ ! -f "$file" ]]; then
        return
    fi

    local in_require=false

    while IFS= read -r line || [[ -n "$line" ]]; do
        # Detect require block
        if echo "$line" | grep -q '^require[[:space:]]*('; then
            in_require=true
            continue
        elif echo "$line" | grep -q '^require[[:space:]]'; then
            # Single-line require
            local dep_name
            dep_name=$(echo "$line" | sed 's/require[[:space:]]*//' | awk '{print $1}')
            if [[ -n "$dep_name" ]]; then
                # Get just the package name part
                local short_name
                short_name=$(basename "$dep_name")
                local category
                category=$(categorize_dependency "$short_name")
                echo "$short_name|$category|prod|go"
            fi
            continue
        elif echo "$line" | grep -q '^)'; then
            in_require=false
            continue
        fi

        if $in_require; then
            local dep_name
            dep_name=$(echo "$line" | awk '{print $1}' | tr -d '[:space:]')
            if [[ -n "$dep_name" ]] && [[ ! "$dep_name" =~ ^// ]]; then
                local short_name
                short_name=$(basename "$dep_name")
                local category
                category=$(categorize_dependency "$short_name")
                echo "$short_name|$category|prod|go"
            fi
        fi
    done < "$file"
}

# Analyze Ruby dependencies from Gemfile
analyze_ruby_dependencies() {
    local file="$1"

    if [[ ! -f "$file" ]]; then
        return
    fi

    local in_dev_group=false

    while IFS= read -r line || [[ -n "$line" ]]; do
        # Skip comments
        [[ "$line" =~ ^[[:space:]]*# ]] && continue

        # Detect groups
        if echo "$line" | grep -q "group.*:development\|group.*:test"; then
            in_dev_group=true
            continue
        elif echo "$line" | grep -q '^end'; then
            in_dev_group=false
            continue
        fi

        # Extract gem name
        local dep_name
        dep_name=$(echo "$line" | sed -n "s/.*gem[[:space:]]*['\"]\\([^'\"]*\\)['\"].*/\\1/p")
        if [[ -n "$dep_name" ]]; then
            local category
            category=$(categorize_dependency "$dep_name")
            if $in_dev_group; then
                echo "$dep_name|$category|dev|gem"
            else
                echo "$dep_name|$category|prod|gem"
            fi
        fi
    done < "$file"
}

# Main dependency analysis function
analyze_dependencies() {
    local dir="${1:-.}"
    local all_deps=""

    # Collect from all sources
    if [[ -f "$dir/package.json" ]]; then
        all_deps+=$(analyze_npm_dependencies "$dir/package.json")
        all_deps+=$'\n'
    fi

    all_deps+=$(analyze_python_dependencies "$dir")
    all_deps+=$'\n'

    if [[ -f "$dir/Cargo.toml" ]]; then
        all_deps+=$(analyze_rust_dependencies "$dir/Cargo.toml")
        all_deps+=$'\n'
    fi

    if [[ -f "$dir/go.mod" ]]; then
        all_deps+=$(analyze_go_dependencies "$dir/go.mod")
        all_deps+=$'\n'
    fi

    if [[ -f "$dir/Gemfile" ]]; then
        all_deps+=$(analyze_ruby_dependencies "$dir/Gemfile")
        all_deps+=$'\n'
    fi

    # Remove empty lines and duplicates, output sorted by category
    echo "$all_deps" | grep -v '^$' | sort -t'|' -k2,2 -k1,1 | uniq
}

# Format dependencies for display
format_dependencies_summary() {
    local deps="$1"

    if [[ -z "$deps" ]]; then
        return
    fi

    # Group by category
    local frameworks=""
    local databases=""
    local testing=""
    local utilities=""
    local other=""

    while IFS='|' read -r name category type source; do
        [[ -z "$name" ]] && continue

        local entry="$name"
        [[ "$type" == "dev" ]] && entry="$name (dev)"

        case "$category" in
            framework)
                frameworks+="$entry, "
                ;;
            database)
                databases+="$entry, "
                ;;
            testing)
                testing+="$entry, "
                ;;
            utilities)
                utilities+="$entry, "
                ;;
            *)
                other+="$entry, "
                ;;
        esac
    done <<< "$deps"

    # Output formatted sections
    if [[ -n "$frameworks" ]]; then
        echo "**Frameworks:** ${frameworks%, }"
    fi
    if [[ -n "$databases" ]]; then
        echo "**Database:** ${databases%, }"
    fi
    if [[ -n "$testing" ]]; then
        echo "**Testing:** ${testing%, }"
    fi
    if [[ -n "$utilities" ]]; then
        echo "**Utilities:** ${utilities%, }"
    fi
    if [[ -n "$other" ]]; then
        # Only show "other" if there are notable packages (limit to first 10)
        local other_count
        other_count=$(echo "$other" | tr ',' '\n' | wc -l)
        if [[ $other_count -le 15 ]]; then
            echo "**Other:** ${other%, }"
        else
            # Truncate with count
            local truncated
            truncated=$(echo "$other" | tr ',' '\n' | head -10 | tr '\n' ',' | sed 's/,$//')
            echo "**Other:** $truncated, ... (+$((other_count - 10)) more)"
        fi
    fi
}

# ============================================================================
# C4 DIAGRAM GENERATION
# ============================================================================

# Detect external systems from dependencies
# Returns: system_name|type|interaction (one per line)
# Types: database, queue, auth, storage, api, monitoring
detect_external_systems() {
    local deps="$1"
    local systems=()

    if [[ -z "$deps" ]]; then
        return
    fi

    # Database systems
    if echo "$deps" | grep -qiE 'pg|postgres|postgresql'; then
        systems+=("PostgreSQL|database|reads from, writes to")
    fi
    if echo "$deps" | grep -qiE 'mysql|mysql2'; then
        systems+=("MySQL|database|reads from, writes to")
    fi
    if echo "$deps" | grep -qiE 'mongodb|mongoose'; then
        systems+=("MongoDB|database|reads from, writes to")
    fi
    if echo "$deps" | grep -qiE 'sqlite|sqlite3'; then
        systems+=("SQLite|database|reads from, writes to")
    fi
    if echo "$deps" | grep -qiE 'prisma|@prisma'; then
        # Prisma is an ORM, try to detect underlying DB
        if ! echo "$deps" | grep -qiE 'pg|mysql|mongodb|sqlite'; then
            systems+=("Database (via Prisma)|database|reads from, writes to")
        fi
    fi
    if echo "$deps" | grep -qiE 'sequelize|typeorm|drizzle'; then
        # ORMs without detected DB
        if ! echo "$deps" | grep -qiE 'pg|mysql|mongodb|sqlite'; then
            systems+=("Database (via ORM)|database|reads from, writes to")
        fi
    fi

    # Message queues
    if echo "$deps" | grep -qiE '\bredis\b|ioredis'; then
        systems+=("Redis|queue|publishes to, subscribes from")
    fi
    if echo "$deps" | grep -qiE 'bull|bullmq'; then
        if ! echo "$deps" | grep -qiE '\bredis\b|ioredis'; then
            systems+=("Redis (via Bull)|queue|processes jobs from")
        fi
    fi
    if echo "$deps" | grep -qiE 'amqplib|amqp'; then
        systems+=("RabbitMQ|queue|publishes to, consumes from")
    fi
    if echo "$deps" | grep -qiE '@aws-sdk.*sqs|sqs'; then
        systems+=("Amazon SQS|queue|sends to, receives from")
    fi
    if echo "$deps" | grep -qiE 'kafka|kafkajs'; then
        systems+=("Apache Kafka|queue|produces to, consumes from")
    fi

    # Auth providers
    if echo "$deps" | grep -qiE 'passport'; then
        systems+=("Auth Provider (Passport)|auth|authenticates via")
    fi
    if echo "$deps" | grep -qiE 'auth0|@auth0'; then
        systems+=("Auth0|auth|authenticates via")
    fi
    if echo "$deps" | grep -qiE 'firebase-admin|firebase'; then
        systems+=("Firebase|auth|authenticates via")
    fi
    if echo "$deps" | grep -qiE 'jsonwebtoken|jwt'; then
        # JWT alone doesn't imply external system
        :
    fi
    if echo "$deps" | grep -qiE 'clerk|@clerk'; then
        systems+=("Clerk|auth|authenticates via")
    fi
    if echo "$deps" | grep -qiE 'next-auth|@next-auth'; then
        systems+=("NextAuth|auth|authenticates via")
    fi

    # Cloud storage
    if echo "$deps" | grep -qiE 'aws-sdk|@aws-sdk.*s3'; then
        systems+=("Amazon S3|storage|stores files in")
    fi
    if echo "$deps" | grep -qiE '@google-cloud/storage|gcs'; then
        systems+=("Google Cloud Storage|storage|stores files in")
    fi
    if echo "$deps" | grep -qiE 'cloudinary'; then
        systems+=("Cloudinary|storage|stores images in")
    fi
    if echo "$deps" | grep -qiE '@azure/storage-blob'; then
        systems+=("Azure Blob Storage|storage|stores files in")
    fi

    # External APIs
    if echo "$deps" | grep -qiE 'stripe|@stripe'; then
        systems+=("Stripe|api|processes payments via")
    fi
    if echo "$deps" | grep -qiE 'twilio|@twilio'; then
        systems+=("Twilio|api|sends messages via")
    fi
    if echo "$deps" | grep -qiE 'sendgrid|@sendgrid'; then
        systems+=("SendGrid|api|sends emails via")
    fi
    if echo "$deps" | grep -qiE 'mailgun'; then
        systems+=("Mailgun|api|sends emails via")
    fi
    if echo "$deps" | grep -qiE 'openai'; then
        systems+=("OpenAI API|api|uses AI via")
    fi
    if echo "$deps" | grep -qiE '@anthropic'; then
        systems+=("Anthropic API|api|uses AI via")
    fi

    # Monitoring/Observability
    if echo "$deps" | grep -qiE '@sentry|sentry'; then
        systems+=("Sentry|monitoring|reports errors to")
    fi
    if echo "$deps" | grep -qiE 'datadog|dd-trace'; then
        systems+=("Datadog|monitoring|sends metrics to")
    fi
    if echo "$deps" | grep -qiE 'newrelic'; then
        systems+=("New Relic|monitoring|sends telemetry to")
    fi

    # Output detected systems
    for sys in "${systems[@]}"; do
        echo "$sys"
    done
}

# Infer users/actors from framework type
# Returns: actor_name|description (one per line)
detect_actors() {
    local frameworks="$1"
    local actors=()

    # Default actor for any app
    actors+=("User|End user of the application")

    # Web apps typically have browser users
    if echo "$frameworks" | grep -qiE 'react|vue|angular|svelte|next|nuxt|gatsby'; then
        actors=("Web User|Uses the application via web browser")
    fi

    # CLI tools have command-line users
    if echo "$frameworks" | grep -qiE 'commander|yargs|click|typer|clap|cobra'; then
        actors=("CLI User|Uses the application via command line")
    fi

    # API servers typically have API consumers
    if echo "$frameworks" | grep -qiE 'express|fastify|nestjs|django|flask|fastapi|rails|gin|actix|axum'; then
        actors+=("API Consumer|External system consuming the API")
    fi

    # Mobile frameworks
    if echo "$frameworks" | grep -qiE 'react-native|expo|flutter'; then
        actors=("Mobile User|Uses the application via mobile device")
    fi

    # Output unique actors
    printf '%s\n' "${actors[@]}" | sort -u
}

# Determine system type description from frameworks
get_system_type() {
    local frameworks="$1"

    if echo "$frameworks" | grep -qiE 'next|nuxt|gatsby'; then
        echo "Full-stack Web Application"
    elif echo "$frameworks" | grep -qiE 'react|vue|angular|svelte'; then
        echo "Single Page Application"
    elif echo "$frameworks" | grep -qiE 'express|fastify|nestjs|django|flask|fastapi|rails|gin|actix|axum|spring'; then
        echo "API Server"
    elif echo "$frameworks" | grep -qiE 'electron'; then
        echo "Desktop Application"
    elif echo "$frameworks" | grep -qiE 'react-native|expo|flutter'; then
        echo "Mobile Application"
    elif echo "$frameworks" | grep -qiE 'commander|yargs|click|typer|clap|cobra'; then
        echo "Command Line Tool"
    else
        echo "Software System"
    fi
}

# Generate C4 System Context diagram in Mermaid format
# Args: system_name, system_type, actors (newline-separated), external_systems (newline-separated)
generate_c4_context_mermaid() {
    local system_name="$1"
    local system_type="$2"
    local actors="$3"
    local external_systems="$4"

    local mermaid=""
    mermaid+="C4Context"$'\n'
    mermaid+="    title System Context diagram for $system_name"$'\n'
    mermaid+=""$'\n'

    # Add actors
    local actor_id=0
    while IFS='|' read -r actor_name actor_desc; do
        [[ -z "$actor_name" ]] && continue
        ((actor_id++))
        local safe_id
        safe_id=$(echo "$actor_name" | tr ' ' '_' | tr -cd '[:alnum:]_')
        mermaid+="    Person(${safe_id}, \"$actor_name\", \"$actor_desc\")"$'\n'
    done <<< "$actors"
    mermaid+=""$'\n'

    # Add the main system
    local system_id
    system_id=$(echo "$system_name" | tr ' ' '_' | tr -cd '[:alnum:]_')
    mermaid+="    System(${system_id}, \"$system_name\", \"$system_type\")"$'\n'
    mermaid+=""$'\n'

    # Add external systems by type
    local has_boundary=false
    local current_boundary=""

    while IFS='|' read -r ext_name ext_type ext_interaction; do
        [[ -z "$ext_name" ]] && continue

        local ext_id
        ext_id=$(echo "$ext_name" | tr ' ' '_' | tr -cd '[:alnum:]_')

        case "$ext_type" in
            database)
                mermaid+="    SystemDb(${ext_id}, \"$ext_name\", \"Database\")"$'\n'
                ;;
            queue)
                mermaid+="    SystemQueue(${ext_id}, \"$ext_name\", \"Message Queue\")"$'\n'
                ;;
            *)
                mermaid+="    System_Ext(${ext_id}, \"$ext_name\", \"External System\")"$'\n'
                ;;
        esac
    done <<< "$external_systems"
    mermaid+=""$'\n'

    # Add relationships from actors to main system
    actor_id=0
    while IFS='|' read -r actor_name actor_desc; do
        [[ -z "$actor_name" ]] && continue
        ((actor_id++))
        local safe_id
        safe_id=$(echo "$actor_name" | tr ' ' '_' | tr -cd '[:alnum:]_')
        mermaid+="    Rel(${safe_id}, ${system_id}, \"Uses\")"$'\n'
    done <<< "$actors"

    # Add relationships from main system to external systems
    while IFS='|' read -r ext_name ext_type ext_interaction; do
        [[ -z "$ext_name" ]] && continue
        local ext_id
        ext_id=$(echo "$ext_name" | tr ' ' '_' | tr -cd '[:alnum:]_')
        mermaid+="    Rel(${system_id}, ${ext_id}, \"$ext_interaction\")"$'\n'
    done <<< "$external_systems"

    echo "$mermaid"
}

# Generate C4 Container diagram in Mermaid format
# Args: system_name, frameworks, deps, dirs (detected directories)
generate_c4_container_mermaid() {
    local system_name="$1"
    local frameworks="$2"
    local deps="$3"
    local dirs="$4"

    local mermaid=""
    mermaid+="C4Container"$'\n'
    mermaid+="    title Container diagram for $system_name"$'\n'
    mermaid+=""$'\n'

    # Boundary for main system
    local system_id
    system_id=$(echo "$system_name" | tr ' ' '_' | tr -cd '[:alnum:]_')
    mermaid+="    Container_Boundary(${system_id}_boundary, \"$system_name\") {"$'\n'

    local containers=()
    local container_techs=()

    # Detect containers from framework/structure

    # Web/Frontend container
    if echo "$frameworks" | grep -qiE 'react|vue|angular|svelte'; then
        local tech="JavaScript"
        echo "$frameworks" | grep -qi 'react' && tech="React"
        echo "$frameworks" | grep -qi 'vue' && tech="Vue.js"
        echo "$frameworks" | grep -qi 'angular' && tech="Angular"
        echo "$frameworks" | grep -qi 'svelte' && tech="Svelte"
        containers+=("Web_App|Web Application|$tech|Delivers the user interface")
    fi

    # API/Backend container
    if echo "$frameworks" | grep -qiE 'express|fastify|nestjs|koa|hapi'; then
        local tech="Node.js"
        echo "$frameworks" | grep -qi 'express' && tech="Express.js"
        echo "$frameworks" | grep -qi 'fastify' && tech="Fastify"
        echo "$frameworks" | grep -qi 'nestjs' && tech="NestJS"
        containers+=("API_Server|API Server|$tech|Handles API requests")
    fi

    if echo "$frameworks" | grep -qiE 'django|flask|fastapi'; then
        local tech="Python"
        echo "$frameworks" | grep -qi 'django' && tech="Django"
        echo "$frameworks" | grep -qi 'flask' && tech="Flask"
        echo "$frameworks" | grep -qi 'fastapi' && tech="FastAPI"
        containers+=("API_Server|API Server|$tech|Handles API requests")
    fi

    if echo "$frameworks" | grep -qiE 'rails|sinatra'; then
        local tech="Ruby"
        echo "$frameworks" | grep -qi 'rails' && tech="Ruby on Rails"
        containers+=("API_Server|API Server|$tech|Handles API requests")
    fi

    if echo "$frameworks" | grep -qiE 'gin|echo|fiber|chi'; then
        local tech="Go"
        containers+=("API_Server|API Server|$tech|Handles API requests")
    fi

    if echo "$frameworks" | grep -qiE 'actix|axum|rocket'; then
        local tech="Rust"
        containers+=("API_Server|API Server|$tech|Handles API requests")
    fi

    # Full-stack frameworks
    if echo "$frameworks" | grep -qiE 'next\.js|nextjs|next'; then
        containers+=("Next_App|Next.js Application|Next.js|Full-stack web application with SSR")
    fi

    if echo "$frameworks" | grep -qiE 'nuxt'; then
        containers+=("Nuxt_App|Nuxt.js Application|Nuxt.js|Full-stack web application with SSR")
    fi

    # Worker containers (detected from queue dependencies)
    if echo "$deps" | grep -qiE 'bull|bullmq|celery|sidekiq|faktory'; then
        containers+=("Worker|Background Worker|Job Queue|Processes background jobs")
    fi

    # CLI container
    if echo "$frameworks" | grep -qiE 'commander|yargs|click|typer|clap|cobra'; then
        containers+=("CLI|Command Line Interface|Shell|Provides CLI commands")
    fi

    # If no containers detected, add a generic one
    if [[ ${#containers[@]} -eq 0 ]]; then
        containers+=("App|Application|Various|Main application container")
    fi

    # Output containers
    for container in "${containers[@]}"; do
        IFS='|' read -r c_id c_name c_tech c_desc <<< "$container"
        mermaid+="        Container(${c_id}, \"$c_name\", \"$c_tech\", \"$c_desc\")"$'\n'
    done

    mermaid+="    }"$'\n'
    mermaid+=""$'\n'

    # External systems (databases, queues, etc.)
    local external_systems
    external_systems=$(detect_external_systems "$deps")

    while IFS='|' read -r ext_name ext_type ext_interaction; do
        [[ -z "$ext_name" ]] && continue
        local ext_id
        ext_id=$(echo "$ext_name" | tr ' ' '_' | tr -cd '[:alnum:]_')

        case "$ext_type" in
            database)
                mermaid+="    ContainerDb(${ext_id}, \"$ext_name\", \"Database\", \"Stores application data\")"$'\n'
                ;;
            queue)
                mermaid+="    ContainerQueue(${ext_id}, \"$ext_name\", \"Message Queue\", \"Handles async messaging\")"$'\n'
                ;;
            *)
                mermaid+="    System_Ext(${ext_id}, \"$ext_name\", \"External Service\")"$'\n'
                ;;
        esac
    done <<< "$external_systems"
    mermaid+=""$'\n'

    # Add relationships
    # First container talks to databases/queues
    if [[ ${#containers[@]} -gt 0 ]]; then
        local first_container_id
        first_container_id=$(echo "${containers[0]}" | cut -d'|' -f1)

        while IFS='|' read -r ext_name ext_type ext_interaction; do
            [[ -z "$ext_name" ]] && continue
            local ext_id
            ext_id=$(echo "$ext_name" | tr ' ' '_' | tr -cd '[:alnum:]_')
            mermaid+="    Rel(${first_container_id}, ${ext_id}, \"$ext_interaction\")"$'\n'
        done <<< "$external_systems"
    fi

    echo "$mermaid"
}

# Generate C4 Component diagram in Mermaid format
# Args: system_name, dirs (directory structure), arch_patterns
generate_c4_component_mermaid() {
    local system_name="$1"
    local dirs="$2"
    local arch_patterns="$3"

    local mermaid=""
    mermaid+="C4Component"$'\n'
    mermaid+="    title Component diagram for $system_name"$'\n'
    mermaid+=""$'\n'

    local system_id
    system_id=$(echo "$system_name" | tr ' ' '_' | tr -cd '[:alnum:]_')
    mermaid+="    Container_Boundary(${system_id}_container, \"Application\") {"$'\n'

    local components=()
    local layer_presentation=()
    local layer_business=()
    local layer_data=()

    # Scan for actual directories recursively (max depth 3)
    local all_dirs
    all_dirs=$(find . -maxdepth 3 -type d 2>/dev/null | grep -v '^\.$' | grep -v 'node_modules\|\.git\|__pycache__\|\.venv\|venv\|dist\|build' | xargs -I{} basename {} 2>/dev/null | sort -u)

    # Detect components from directory structure
    # Presentation layer
    if echo "$all_dirs" | grep -qiE '^(routes|api|endpoints|handlers|controllers|views|pages|components)$'; then
        if echo "$all_dirs" | grep -qi '^routes$'; then
            layer_presentation+=("Routes|Routes|Handles HTTP routing")
        fi
        if echo "$all_dirs" | grep -qi '^controllers$'; then
            layer_presentation+=("Controllers|Controllers|Handles request/response")
        fi
        if echo "$all_dirs" | grep -qi '^handlers$'; then
            layer_presentation+=("Handlers|Handlers|Handles incoming requests")
        fi
        if echo "$all_dirs" | grep -qi '^views$'; then
            layer_presentation+=("Views|Views|Renders UI templates")
        fi
        if echo "$all_dirs" | grep -qi '^pages$'; then
            layer_presentation+=("Pages|Pages|Page-level components")
        fi
        if echo "$all_dirs" | grep -qi '^components$'; then
            layer_presentation+=("UI_Components|UI Components|Reusable UI components")
        fi
    fi

    # Business layer
    if echo "$all_dirs" | grep -qiE '^(services|business|domain|usecases|core)$'; then
        if echo "$all_dirs" | grep -qi '^services$'; then
            layer_business+=("Services|Services|Business logic and orchestration")
        fi
        if echo "$all_dirs" | grep -qi '^domain$'; then
            layer_business+=("Domain|Domain|Core business rules")
        fi
        if echo "$all_dirs" | grep -qi '^usecases$'; then
            layer_business+=("UseCases|Use Cases|Application use cases")
        fi
    fi

    # Data layer
    if echo "$all_dirs" | grep -qiE '^(models|entities|repositories|dal|data)$'; then
        if echo "$all_dirs" | grep -qi '^models$'; then
            layer_data+=("Models|Models|Data models and schemas")
        fi
        if echo "$all_dirs" | grep -qi '^entities$'; then
            layer_data+=("Entities|Entities|Domain entities")
        fi
        if echo "$all_dirs" | grep -qi '^repositories$'; then
            layer_data+=("Repositories|Repositories|Data access abstraction")
        fi
    fi

    # Utilities/Infrastructure
    local layer_infra=()
    if echo "$all_dirs" | grep -qiE '^(utils|lib|helpers|common|shared|middleware|config)$'; then
        if echo "$all_dirs" | grep -qi '^middleware$'; then
            layer_infra+=("Middleware|Middleware|Request/response middleware")
        fi
        if echo "$all_dirs" | grep -qi '^utils$'; then
            layer_infra+=("Utils|Utilities|Shared utility functions")
        fi
        if echo "$all_dirs" | grep -qi '^config$'; then
            layer_infra+=("Config|Configuration|Application configuration")
        fi
    fi

    # Output presentation layer
    if [[ ${#layer_presentation[@]} -gt 0 ]]; then
        mermaid+="        %% Presentation Layer"$'\n'
        for comp in "${layer_presentation[@]}"; do
            IFS='|' read -r c_id c_name c_desc <<< "$comp"
            mermaid+="        Component(${c_id}, \"$c_name\", \"\", \"$c_desc\")"$'\n'
        done
        mermaid+=""$'\n'
    fi

    # Output business layer
    if [[ ${#layer_business[@]} -gt 0 ]]; then
        mermaid+="        %% Business Layer"$'\n'
        for comp in "${layer_business[@]}"; do
            IFS='|' read -r c_id c_name c_desc <<< "$comp"
            mermaid+="        Component(${c_id}, \"$c_name\", \"\", \"$c_desc\")"$'\n'
        done
        mermaid+=""$'\n'
    fi

    # Output data layer
    if [[ ${#layer_data[@]} -gt 0 ]]; then
        mermaid+="        %% Data Layer"$'\n'
        for comp in "${layer_data[@]}"; do
            IFS='|' read -r c_id c_name c_desc <<< "$comp"
            mermaid+="        Component(${c_id}, \"$c_name\", \"\", \"$c_desc\")"$'\n'
        done
        mermaid+=""$'\n'
    fi

    # Output infrastructure layer
    if [[ ${#layer_infra[@]} -gt 0 ]]; then
        mermaid+="        %% Infrastructure Layer"$'\n'
        for comp in "${layer_infra[@]}"; do
            IFS='|' read -r c_id c_name c_desc <<< "$comp"
            mermaid+="        Component(${c_id}, \"$c_name\", \"\", \"$c_desc\")"$'\n'
        done
        mermaid+=""$'\n'
    fi

    # If no components detected, add generic ones
    if [[ ${#layer_presentation[@]} -eq 0 ]] && [[ ${#layer_business[@]} -eq 0 ]] && [[ ${#layer_data[@]} -eq 0 ]]; then
        mermaid+="        Component(Main, \"Main\", \"\", \"Main application logic\")"$'\n'
    fi

    mermaid+="    }"$'\n'
    mermaid+=""$'\n'

    # Add relationships between layers
    # Presentation -> Business
    if [[ ${#layer_presentation[@]} -gt 0 ]] && [[ ${#layer_business[@]} -gt 0 ]]; then
        local pres_id
        pres_id=$(echo "${layer_presentation[0]}" | cut -d'|' -f1)
        local bus_id
        bus_id=$(echo "${layer_business[0]}" | cut -d'|' -f1)
        mermaid+="    Rel(${pres_id}, ${bus_id}, \"Uses\")"$'\n'
    fi

    # Business -> Data
    if [[ ${#layer_business[@]} -gt 0 ]] && [[ ${#layer_data[@]} -gt 0 ]]; then
        local bus_id
        bus_id=$(echo "${layer_business[0]}" | cut -d'|' -f1)
        local data_id
        data_id=$(echo "${layer_data[0]}" | cut -d'|' -f1)
        mermaid+="    Rel(${bus_id}, ${data_id}, \"Uses\")"$'\n'
    fi

    # Presentation -> Data (if no business layer)
    if [[ ${#layer_presentation[@]} -gt 0 ]] && [[ ${#layer_business[@]} -eq 0 ]] && [[ ${#layer_data[@]} -gt 0 ]]; then
        local pres_id
        pres_id=$(echo "${layer_presentation[0]}" | cut -d'|' -f1)
        local data_id
        data_id=$(echo "${layer_data[0]}" | cut -d'|' -f1)
        mermaid+="    Rel(${pres_id}, ${data_id}, \"Uses\")"$'\n'
    fi

    echo "$mermaid"
}

# Generate self-contained HTML file with C4 diagrams
# Args: output_file, system_name, context_mermaid, container_mermaid, component_mermaid, diagram_level
generate_c4_html() {
    local output_file="$1"
    local system_name="$2"
    local context_mermaid="$3"
    local container_mermaid="$4"
    local component_mermaid="$5"
    local diagram_level="${6:-component}"

    local timestamp
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')

    cat > "$output_file" << 'HTMLEOF'
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>C4 Architecture Diagram - SYSTEM_NAME_PLACEHOLDER</title>
    <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
    <style>
        :root {
            --bg-color: #ffffff;
            --text-color: #333333;
            --border-color: #e0e0e0;
            --tab-bg: #f5f5f5;
            --tab-active-bg: #ffffff;
            --tab-hover-bg: #e8e8e8;
        }

        [data-theme="dark"] {
            --bg-color: #1e1e1e;
            --text-color: #e0e0e0;
            --border-color: #444444;
            --tab-bg: #2d2d2d;
            --tab-active-bg: #1e1e1e;
            --tab-hover-bg: #3d3d3d;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            margin: 0;
            padding: 20px;
            background-color: var(--bg-color);
            color: var(--text-color);
            transition: background-color 0.3s, color 0.3s;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--border-color);
        }

        h1 {
            margin: 0;
            font-size: 1.5em;
        }

        .controls {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        button {
            padding: 8px 16px;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            background: var(--tab-bg);
            color: var(--text-color);
            cursor: pointer;
            font-size: 14px;
            transition: background-color 0.2s;
        }

        button:hover {
            background: var(--tab-hover-bg);
        }

        .tabs {
            display: flex;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 20px;
        }

        .tab {
            padding: 12px 24px;
            border: none;
            background: var(--tab-bg);
            cursor: pointer;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            font-size: 14px;
            color: var(--text-color);
            transition: all 0.2s;
        }

        .tab:hover {
            background: var(--tab-hover-bg);
        }

        .tab.active {
            background: var(--tab-active-bg);
            border-bottom-color: #4a90d9;
            font-weight: 500;
        }

        .diagram-container {
            display: none;
            min-height: 400px;
            overflow: auto;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 20px;
            position: relative;
        }

        .diagram-container.active {
            display: block;
        }

        .diagram-wrapper {
            transform-origin: top left;
            transition: transform 0.1s ease-out;
        }

        .zoom-controls {
            position: absolute;
            top: 10px;
            right: 10px;
            display: flex;
            gap: 5px;
            background: var(--bg-color);
            padding: 5px;
            border-radius: 4px;
            border: 1px solid var(--border-color);
            z-index: 10;
        }

        .zoom-controls button {
            width: 32px;
            height: 32px;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .footer {
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid var(--border-color);
            font-size: 12px;
            color: #888;
            display: flex;
            justify-content: space-between;
        }

        .mermaid {
            text-align: center;
        }

        /* Dark mode for Mermaid diagrams */
        [data-theme="dark"] .mermaid {
            filter: invert(0.9) hue-rotate(180deg);
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>SYSTEM_NAME_PLACEHOLDER - C4 Architecture</h1>
        <div class="controls">
            <button onclick="toggleTheme()" id="themeBtn">🌙 Dark Mode</button>
            <button onclick="exportPNG()">📷 Export PNG</button>
        </div>
    </div>

    <div class="tabs">
        <button class="tab active" onclick="showTab('context')">System Context</button>
        <!-- CONTAINER_TAB_PLACEHOLDER -->
        <!-- COMPONENT_TAB_PLACEHOLDER -->
    </div>

    <div id="context" class="diagram-container active">
        <div class="zoom-controls">
            <button onclick="zoomIn('context')">+</button>
            <button onclick="zoomOut('context')">−</button>
            <button onclick="resetZoom('context')">⟲</button>
        </div>
        <div class="diagram-wrapper" id="context-wrapper">
            <div class="mermaid" id="context-diagram">
CONTEXT_MERMAID_PLACEHOLDER
            </div>
        </div>
    </div>

    <!-- CONTAINER_DIAGRAM_PLACEHOLDER -->

    <!-- COMPONENT_DIAGRAM_PLACEHOLDER -->

    <div class="footer">
        <span>Generated by FADE vFADE_VERSION_PLACEHOLDER</span>
        <span>TIMESTAMP_PLACEHOLDER</span>
    </div>

    <script>
        // Initialize Mermaid
        mermaid.initialize({
            startOnLoad: true,
            theme: 'default',
            securityLevel: 'loose',
            c4: {
                useMaxWidth: true
            }
        });

        // Zoom state for each diagram
        const zoomState = {
            context: 1,
            container: 1,
            component: 1
        };

        function showTab(tabName) {
            // Hide all containers
            document.querySelectorAll('.diagram-container').forEach(c => {
                c.classList.remove('active');
            });
            // Deactivate all tabs
            document.querySelectorAll('.tab').forEach(t => {
                t.classList.remove('active');
            });
            // Show selected container
            document.getElementById(tabName).classList.add('active');
            // Activate selected tab
            event.target.classList.add('active');
        }

        function zoomIn(id) {
            zoomState[id] = Math.min(zoomState[id] + 0.1, 2);
            applyZoom(id);
        }

        function zoomOut(id) {
            zoomState[id] = Math.max(zoomState[id] - 0.1, 0.5);
            applyZoom(id);
        }

        function resetZoom(id) {
            zoomState[id] = 1;
            applyZoom(id);
        }

        function applyZoom(id) {
            const wrapper = document.getElementById(id + '-wrapper');
            if (wrapper) {
                wrapper.style.transform = `scale(${zoomState[id]})`;
            }
        }

        function toggleTheme() {
            const body = document.body;
            const btn = document.getElementById('themeBtn');
            if (body.getAttribute('data-theme') === 'dark') {
                body.removeAttribute('data-theme');
                btn.textContent = '🌙 Dark Mode';
            } else {
                body.setAttribute('data-theme', 'dark');
                btn.textContent = '☀️ Light Mode';
            }
        }

        function exportPNG() {
            const activeContainer = document.querySelector('.diagram-container.active');
            const svg = activeContainer.querySelector('svg');
            if (!svg) {
                alert('Diagram not ready yet. Please wait for it to render.');
                return;
            }

            // Create canvas
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            const svgData = new XMLSerializer().serializeToString(svg);
            const img = new Image();

            // Set canvas size
            const bbox = svg.getBoundingClientRect();
            canvas.width = bbox.width * 2;
            canvas.height = bbox.height * 2;
            ctx.scale(2, 2);
            ctx.fillStyle = 'white';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            img.onload = function() {
                ctx.drawImage(img, 0, 0);
                const link = document.createElement('a');
                link.download = 'c4-diagram.png';
                link.href = canvas.toDataURL('image/png');
                link.click();
            };

            img.src = 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(svgData)));
        }
    </script>
</body>
</html>
HTMLEOF

    # Replace simple placeholders
    sed -i.bak "s/SYSTEM_NAME_PLACEHOLDER/$system_name/g" "$output_file"
    sed -i.bak "s/FADE_VERSION_PLACEHOLDER/$FADE_VERSION/g" "$output_file"
    sed -i.bak "s/TIMESTAMP_PLACEHOLDER/$timestamp/g" "$output_file"

    # Write mermaid content to temporary files for reliable replacement
    local context_tmp="${output_file}.context.tmp"
    local container_tmp="${output_file}.container.tmp"
    local component_tmp="${output_file}.component.tmp"

    echo "$context_mermaid" > "$context_tmp"

    # Replace CONTEXT_MERMAID_PLACEHOLDER using file-based approach
    local temp_file="${output_file}.tmp"
    while IFS= read -r line; do
        if [[ "$line" == *"CONTEXT_MERMAID_PLACEHOLDER"* ]]; then
            cat "$context_tmp"
        else
            echo "$line"
        fi
    done < "$output_file" > "$temp_file"
    mv "$temp_file" "$output_file"
    rm -f "$context_tmp"

    # Add container tab and diagram if needed
    if [[ "$diagram_level" == "container" ]] || [[ "$diagram_level" == "component" ]]; then
        sed -i.bak 's/<!-- CONTAINER_TAB_PLACEHOLDER -->/<button class="tab" onclick="showTab('\''container'\'')">Container<\/button>/' "$output_file"

        # Build container HTML content
        {
            echo '<div id="container" class="diagram-container">'
            echo '        <div class="zoom-controls">'
            echo "            <button onclick=\"zoomIn('container')\">+</button>"
            echo "            <button onclick=\"zoomOut('container')\">−</button>"
            echo "            <button onclick=\"resetZoom('container')\">⟲</button>"
            echo '        </div>'
            echo '        <div class="diagram-wrapper" id="container-wrapper">'
            echo '            <div class="mermaid" id="container-diagram">'
            echo "$container_mermaid"
            echo '            </div>'
            echo '        </div>'
            echo '    </div>'
        } > "$container_tmp"

        # Replace placeholder
        while IFS= read -r line; do
            if [[ "$line" == *"<!-- CONTAINER_DIAGRAM_PLACEHOLDER -->"* ]]; then
                cat "$container_tmp"
            else
                echo "$line"
            fi
        done < "$output_file" > "$temp_file"
        mv "$temp_file" "$output_file"
        rm -f "$container_tmp"
    else
        sed -i.bak 's/<!-- CONTAINER_TAB_PLACEHOLDER -->//' "$output_file"
        sed -i.bak 's/<!-- CONTAINER_DIAGRAM_PLACEHOLDER -->//' "$output_file"
    fi

    # Add component tab and diagram if needed
    if [[ "$diagram_level" == "component" ]]; then
        sed -i.bak 's/<!-- COMPONENT_TAB_PLACEHOLDER -->/<button class="tab" onclick="showTab('\''component'\'')">Component<\/button>/' "$output_file"

        # Build component HTML content
        {
            echo '<div id="component" class="diagram-container">'
            echo '        <div class="zoom-controls">'
            echo "            <button onclick=\"zoomIn('component')\">+</button>"
            echo "            <button onclick=\"zoomOut('component')\">−</button>"
            echo "            <button onclick=\"resetZoom('component')\">⟲</button>"
            echo '        </div>'
            echo '        <div class="diagram-wrapper" id="component-wrapper">'
            echo '            <div class="mermaid" id="component-diagram">'
            echo "$component_mermaid"
            echo '            </div>'
            echo '        </div>'
            echo '    </div>'
        } > "$component_tmp"

        # Replace placeholder
        while IFS= read -r line; do
            if [[ "$line" == *"<!-- COMPONENT_DIAGRAM_PLACEHOLDER -->"* ]]; then
                cat "$component_tmp"
            else
                echo "$line"
            fi
        done < "$output_file" > "$temp_file"
        mv "$temp_file" "$output_file"
        rm -f "$component_tmp"
    else
        sed -i.bak 's/<!-- COMPONENT_TAB_PLACEHOLDER -->//' "$output_file"
        sed -i.bak 's/<!-- COMPONENT_DIAGRAM_PLACEHOLDER -->//' "$output_file"
    fi

    # Clean up backup files
    rm -f "${output_file}.bak"
}

cmd_map() {
    local init_mode=false
    local force_mode=false
    local diagram_mode=false
    local diagram_level="component"
    local diagram_output="architecture.html"
    local diagram_title=""
    local diagram_format="html"

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --init)
                init_mode=true
                shift
                ;;
            --force)
                force_mode=true
                shift
                ;;
            --diagram)
                diagram_mode=true
                shift
                ;;
            --diagram=*)
                diagram_mode=true
                diagram_level="${1#--diagram=}"
                if [[ ! "$diagram_level" =~ ^(context|container|component)$ ]]; then
                    echo -e "${RED}Invalid diagram level: $diagram_level${NC}"
                    echo "Valid levels: context, container, component"
                    return 1
                fi
                shift
                ;;
            --diagram-output=*)
                diagram_output="${1#--diagram-output=}"
                shift
                ;;
            --diagram-title=*)
                diagram_title="${1#--diagram-title=}"
                shift
                ;;
            --diagram-format=*)
                diagram_format="${1#--diagram-format=}"
                if [[ ! "$diagram_format" =~ ^(html|mermaid)$ ]]; then
                    echo -e "${RED}Invalid diagram format: $diagram_format${NC}"
                    echo "Valid formats: html, mermaid"
                    return 1
                fi
                shift
                ;;
            *)
                echo -e "${RED}Unknown option: $1${NC}"
                echo "Usage: fade map [--init] [--force] [--diagram[=level]] [--diagram-output=PATH] [--diagram-title=NAME] [--diagram-format=FORMAT]"
                return 1
                ;;
        esac
    done

    # Check if FADE.md exists (relevant for --init mode)
    if [[ "$init_mode" == true ]] && [[ -f "FADE.md" ]] && [[ "$force_mode" != true ]]; then
        echo -e "${YELLOW}FADE.md already exists.${NC}"
        echo "Use --force to overwrite: fade map --init --force"
        return 1
    fi

    echo -e "${CYAN}FADE Codebase Map${NC}"
    echo ""

    # =========================================================================
    # GITIGNORE PARSING
    # =========================================================================
    # Parse .gitignore to build exclusion patterns
    parse_gitignore "."
    count_excluded_paths "."

    # Show exclusion summary for transparency
    local exclusion_summary
    exclusion_summary=$(get_exclusion_summary)
    echo -e "${YELLOW}## Exclusions${NC}"
    echo ""
    if [[ -f ".gitignore" ]]; then
        echo "Using .gitignore: ${GREEN}yes${NC}"
        echo "Patterns: $exclusion_summary"
    else
        echo "Using .gitignore: ${YELLOW}not found${NC} (using defaults only)"
        echo "Patterns: $exclusion_summary"
    fi
    echo ""

    # =========================================================================
    # LANGUAGE DETECTION
    # =========================================================================
    echo -e "${YELLOW}## Languages${NC}"
    echo ""

    local lang_output
    lang_output=$(detect_languages ".")

    if [[ -z "$lang_output" ]]; then
        echo "No source files detected."
    else
        echo "Primary languages by file count:"
        echo ""
        echo '```'
        echo "$lang_output" | while read -r count ext; do
            local lang_name
            lang_name=$(extension_to_language "$ext")
            printf "%6d  %-20s (%s)\n" "$count" "$lang_name" ".$ext"
        done
        echo '```'
    fi
    echo ""

    # =========================================================================
    # FRAMEWORK DETECTION
    # =========================================================================
    echo -e "${YELLOW}## Frameworks & Libraries${NC}"
    echo ""

    local frameworks
    frameworks=$(detect_framework ".")

    if [[ -z "$frameworks" ]]; then
        echo "No frameworks detected from manifest files."
    else
        echo "Detected frameworks:"
        echo ""
        echo "$frameworks" | while read -r fw; do
            echo "- $fw"
        done
    fi
    echo ""

    # =========================================================================
    # DEPENDENCY ANALYSIS
    # =========================================================================
    echo -e "${YELLOW}## Dependencies${NC}"
    echo ""

    local deps
    deps=$(analyze_dependencies ".")

    if [[ -z "$deps" ]]; then
        echo "No dependency manifest files found (package.json, requirements.txt, etc.)."
    else
        local dep_summary
        dep_summary=$(format_dependencies_summary "$deps")
        if [[ -n "$dep_summary" ]]; then
            echo "Categorized dependencies:"
            echo ""
            echo "$dep_summary"
        else
            echo "Dependencies found but none matched known categories."
        fi

        # Show raw count by source
        echo ""
        echo "Package counts by source:"
        local npm_count py_count rust_count go_count ruby_count
        npm_count=$(echo "$deps" | grep '|npm$' 2>/dev/null | wc -l | tr -d ' ')
        py_count=$(echo "$deps" | grep '|pip$' 2>/dev/null | wc -l | tr -d ' ')
        rust_count=$(echo "$deps" | grep '|cargo$' 2>/dev/null | wc -l | tr -d ' ')
        go_count=$(echo "$deps" | grep '|go$' 2>/dev/null | wc -l | tr -d ' ')
        ruby_count=$(echo "$deps" | grep '|gem$' 2>/dev/null | wc -l | tr -d ' ')

        [[ "$npm_count" -gt 0 ]] && echo "- npm: $npm_count packages"
        [[ "$py_count" -gt 0 ]] && echo "- pip: $py_count packages"
        [[ "$rust_count" -gt 0 ]] && echo "- cargo: $rust_count crates"
        [[ "$go_count" -gt 0 ]] && echo "- go: $go_count modules"
        [[ "$ruby_count" -gt 0 ]] && echo "- gem: $ruby_count gems"

        # Note dev vs prod split
        local dev_count prod_count
        dev_count=$(echo "$deps" | grep '|dev|' 2>/dev/null | wc -l | tr -d ' ')
        prod_count=$(echo "$deps" | grep '|prod|' 2>/dev/null | wc -l | tr -d ' ')
        if [[ "$dev_count" -gt 0 ]]; then
            echo ""
            echo "($prod_count production, $dev_count development)"
        fi
    fi
    echo ""

    # =========================================================================
    # ARCHITECTURE PATTERNS
    # =========================================================================
    echo -e "${YELLOW}## Architecture Patterns${NC}"
    echo ""

    local arch_patterns
    arch_patterns=$(detect_architecture_patterns ".")

    if [[ -z "$arch_patterns" ]]; then
        echo "No common architecture patterns detected."
    else
        echo "Detected patterns:"
        echo ""
        echo "| Pattern | Confidence | Evidence |"
        echo "|---------|------------|----------|"
        echo "$arch_patterns" | while IFS='|' read -r pattern confidence evidence; do
            # Format confidence with color hint in description
            local conf_display
            case "$confidence" in
                certain) conf_display="✓ certain" ;;
                likely) conf_display="○ likely" ;;
                possible) conf_display="? possible" ;;
                *) conf_display="$confidence" ;;
            esac
            echo "| $pattern | $conf_display | $evidence |"
        done
    fi
    echo ""

    # =========================================================================
    # ENTRY POINTS
    # =========================================================================
    echo -e "${YELLOW}## Entry Points${NC}"
    echo ""

    local entries
    entries=$(detect_entry_points ".")

    if [[ -z "$entries" ]]; then
        echo "No standard entry points detected."
    else
        echo "Detected entry points:"
        echo ""
        echo "$entries" | while read -r entry; do
            echo "- \`$entry\`"
        done
    fi
    echo ""

    # =========================================================================
    # DIRECTORY STRUCTURE
    # =========================================================================
    echo -e "${YELLOW}## Directory Structure${NC}"
    echo ""

    local dirs
    dirs=$(describe_directories ".")

    if [[ -z "$dirs" ]]; then
        echo "No directories found."
    else
        echo "Top-level directories:"
        echo ""
        echo '```'
        echo "$dirs"
        echo '```'
    fi
    echo ""

    # =========================================================================
    # FRAGILE AREAS DETECTION
    # =========================================================================
    echo -e "${YELLOW}## Potential Fragile Areas${NC}"
    echo ""

    local fragile_areas
    fragile_areas=$(detect_fragile_areas ".")

    if [[ -z "$fragile_areas" ]]; then
        echo "No potential fragile areas detected."
    else
        echo "Detected potential problem spots:"
        echo ""
        echo "| Path | Reason | Severity |"
        echo "|------|--------|----------|"
        echo "$fragile_areas" | while IFS='|' read -r path reason severity; do
            # Format severity with visual indicator
            local sev_display
            case "$severity" in
                high) sev_display="🔴 high" ;;
                medium) sev_display="🟡 medium" ;;
                low) sev_display="🟢 low" ;;
                *) sev_display="$severity" ;;
            esac
            echo "| \`$path\` | $reason | $sev_display |"
        done
    fi
    echo ""

    # =========================================================================
    # FADE.MD READY OUTPUT
    # =========================================================================
    echo -e "${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}Copy the following into your FADE.md:${NC}"
    echo -e "${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
    echo ""

    echo '```markdown'
    echo "## Project Overview"
    echo ""

    # Language summary
    local top_lang
    top_lang=$(echo "$lang_output" | head -1 | awk '{print $2}')
    if [[ -n "$top_lang" ]]; then
        local primary_lang
        primary_lang=$(extension_to_language "$top_lang")
        echo "**Tech Stack:**"
        echo "- Language: $primary_lang"

        if [[ -n "$frameworks" ]]; then
            local framework_list
            framework_list=$(echo "$frameworks" | head -3 | tr '\n' ', ' | sed 's/,$//' | sed 's/,/, /g')
            echo "- Framework: $framework_list"
        else
            echo "- Framework:"
        fi

        # Extract database from dependencies if detected
        local db_deps=""
        if [[ -n "$deps" ]]; then
            db_deps=$(echo "$deps" | grep '|database|' | cut -d'|' -f1 | head -3 | tr '\n' ', ' | sed 's/,$//' | sed 's/,/, /g')
        fi
        if [[ -n "$db_deps" ]]; then
            echo "- Database: $db_deps"
        else
            echo "- Database:"
        fi
        echo ""
    fi

    # Dependencies summary for FADE.md
    if [[ -n "$deps" ]]; then
        local dep_summary
        dep_summary=$(format_dependencies_summary "$deps")
        if [[ -n "$dep_summary" ]]; then
            echo "### Key Dependencies"
            echo ""
            echo "$dep_summary"
            echo ""
        fi
    fi

    # Architecture hint from directories
    if [[ -n "$dirs" ]]; then
        echo "### Directory Structure"
        echo ""
        echo '```'
        echo "$dirs"
        echo '```'
        echo ""
    fi

    # Architecture patterns for FADE.md
    if [[ -n "$arch_patterns" ]]; then
        echo "### Architecture Patterns"
        echo ""
        echo "| Pattern | Confidence | Evidence |"
        echo "|---------|------------|----------|"
        echo "$arch_patterns" | while IFS='|' read -r pattern confidence evidence; do
            echo "| $pattern | $confidence | $evidence |"
        done
        echo ""
    fi

    # Fragile areas for FADE.md
    if [[ -n "$fragile_areas" ]]; then
        echo "### Potential Fragile Areas"
        echo ""
        echo "| Area | Why it's fragile |"
        echo "|------|------------------|"
        echo "$fragile_areas" | while IFS='|' read -r path reason severity; do
            echo "| \`$path\` | $reason |"
        done
        echo ""
    fi

    echo '```'
    echo ""

    # =========================================================================
    # DIAGRAM GENERATION (--diagram mode)
    # =========================================================================
    if [[ "$diagram_mode" == true ]]; then
        echo -e "${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
        echo -e "${CYAN}Generating C4 Architecture Diagram...${NC}"
        echo -e "${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
        echo ""

        # Determine system name
        local system_name
        if [[ -n "$diagram_title" ]]; then
            system_name="$diagram_title"
        elif [[ -f "package.json" ]]; then
            system_name=$(grep -m1 '"name"' package.json 2>/dev/null | sed 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/' | head -1)
        elif [[ -f "Cargo.toml" ]]; then
            system_name=$(grep -m1 '^name' Cargo.toml 2>/dev/null | sed 's/.*=[[:space:]]*"\([^"]*\)".*/\1/' | head -1)
        elif [[ -f "pyproject.toml" ]]; then
            system_name=$(grep -m1 'name' pyproject.toml 2>/dev/null | sed 's/.*=[[:space:]]*"\([^"]*\)".*/\1/' | head -1)
        fi
        if [[ -z "$system_name" ]]; then
            system_name=$(basename "$(pwd)")
        fi
        echo "System name: $system_name"

        # Detect system type and actors
        local system_type
        system_type=$(get_system_type "$frameworks")
        echo "System type: $system_type"

        local actors
        actors=$(detect_actors "$frameworks")
        echo "Actors detected: $(echo "$actors" | wc -l | tr -d ' ')"

        # Detect external systems
        local external_systems
        external_systems=$(detect_external_systems "$deps")
        local ext_count
        ext_count=$(echo "$external_systems" | grep -c '|' 2>/dev/null || echo "0")
        echo "External systems detected: $ext_count"
        echo ""

        # Generate Mermaid diagrams
        local context_mermaid=""
        local container_mermaid=""
        local component_mermaid=""

        # Always generate context diagram
        context_mermaid=$(generate_c4_context_mermaid "$system_name" "$system_type" "$actors" "$external_systems")

        # Generate container diagram if level is container or component
        if [[ "$diagram_level" == "container" ]] || [[ "$diagram_level" == "component" ]]; then
            container_mermaid=$(generate_c4_container_mermaid "$system_name" "$frameworks" "$deps" "$dirs")
        fi

        # Generate component diagram if level is component
        if [[ "$diagram_level" == "component" ]]; then
            component_mermaid=$(generate_c4_component_mermaid "$system_name" "$dirs" "$arch_patterns")
        fi

        # Output based on format
        if [[ "$diagram_format" == "mermaid" ]]; then
            # Output .mmd files
            local base_name
            base_name="${diagram_output%.html}"
            base_name="${base_name%.mmd}"

            # Context diagram
            echo "# C4 System Context Diagram" > "${base_name}_context.mmd"
            echo "# Generated by FADE v$FADE_VERSION on $(date '+%Y-%m-%d %H:%M:%S')" >> "${base_name}_context.mmd"
            echo "" >> "${base_name}_context.mmd"
            echo '```mermaid' >> "${base_name}_context.mmd"
            echo "$context_mermaid" >> "${base_name}_context.mmd"
            echo '```' >> "${base_name}_context.mmd"
            echo -e "${GREEN}✓ Created ${base_name}_context.mmd${NC}"

            if [[ "$diagram_level" == "container" ]] || [[ "$diagram_level" == "component" ]]; then
                echo "# C4 Container Diagram" > "${base_name}_container.mmd"
                echo "# Generated by FADE v$FADE_VERSION on $(date '+%Y-%m-%d %H:%M:%S')" >> "${base_name}_container.mmd"
                echo "" >> "${base_name}_container.mmd"
                echo '```mermaid' >> "${base_name}_container.mmd"
                echo "$container_mermaid" >> "${base_name}_container.mmd"
                echo '```' >> "${base_name}_container.mmd"
                echo -e "${GREEN}✓ Created ${base_name}_container.mmd${NC}"
            fi

            if [[ "$diagram_level" == "component" ]]; then
                echo "# C4 Component Diagram" > "${base_name}_component.mmd"
                echo "# Generated by FADE v$FADE_VERSION on $(date '+%Y-%m-%d %H:%M:%S')" >> "${base_name}_component.mmd"
                echo "" >> "${base_name}_component.mmd"
                echo '```mermaid' >> "${base_name}_component.mmd"
                echo "$component_mermaid" >> "${base_name}_component.mmd"
                echo '```' >> "${base_name}_component.mmd"
                echo -e "${GREEN}✓ Created ${base_name}_component.mmd${NC}"
            fi
        else
            # Output HTML file
            generate_c4_html "$diagram_output" "$system_name" "$context_mermaid" "$container_mermaid" "$component_mermaid" "$diagram_level"
            echo -e "${GREEN}✓ Created $diagram_output${NC}"
        fi

        echo ""
        echo "Diagram levels included:"
        echo "  - System Context: ✓"
        if [[ "$diagram_level" == "container" ]] || [[ "$diagram_level" == "component" ]]; then
            echo "  - Container: ✓"
        else
            echo "  - Container: (use --diagram=container to include)"
        fi
        if [[ "$diagram_level" == "component" ]]; then
            echo "  - Component: ✓"
        else
            echo "  - Component: (use --diagram=component to include)"
        fi
        echo ""

        if [[ "$diagram_format" != "mermaid" ]]; then
            echo "Open $diagram_output in a browser to view the interactive diagram."
        fi
        return 0
    fi

    # =========================================================================
    # GENERATE FADE.MD (--init mode)
    # =========================================================================
    if [[ "$init_mode" == true ]]; then
        echo -e "${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
        echo -e "${CYAN}Generating FADE.md...${NC}"
        echo -e "${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
        echo ""

        # Build the FADE.md content
        local fade_content=""

        # Header with version and auto-generated notice
        fade_content+="<!-- FADE FADE.md v$FADE_VERSION -->"$'\n'
        fade_content+="<!-- AUTO-GENERATED by 'fade map --init' - Review and customize! -->"$'\n'
        fade_content+=""$'\n'
        fade_content+="# Project Name"$'\n'
        fade_content+=""$'\n'
        fade_content+="<!-- FADE.md - Project context for AI coding agents. This file is READ-ONLY for agents. -->"$'\n'
        fade_content+=""$'\n'
        fade_content+="---"$'\n'
        fade_content+=""$'\n'

        # Project Overview section
        fade_content+="## Project Overview"$'\n'
        fade_content+=""$'\n'
        fade_content+="<!-- AUTO-GENERATED: Review and expand with project description -->"$'\n'
        fade_content+=""$'\n'
        fade_content+="Brief description of this project."$'\n'
        fade_content+=""$'\n'

        # Tech Stack - populated from detection
        fade_content+="<!-- AUTO-GENERATED: Tech stack detected from codebase -->"$'\n'
        fade_content+="**Tech Stack:**"$'\n'

        # Get primary language
        local top_lang primary_lang
        top_lang=$(echo "$lang_output" | head -1 | awk '{print $2}')
        if [[ -n "$top_lang" ]]; then
            primary_lang=$(extension_to_language "$top_lang")
            fade_content+="- Language: $primary_lang"$'\n'
        else
            fade_content+="- Language:"$'\n'
        fi

        # Get frameworks
        if [[ -n "$frameworks" ]]; then
            local framework_list
            framework_list=$(echo "$frameworks" | head -3 | tr '\n' ', ' | sed 's/,$//' | sed 's/,/, /g')
            fade_content+="- Framework: $framework_list"$'\n'
        else
            fade_content+="- Framework:"$'\n'
        fi

        # Get database from dependencies
        local db_deps=""
        if [[ -n "$deps" ]]; then
            db_deps=$(echo "$deps" | grep '|database|' | cut -d'|' -f1 | head -3 | tr '\n' ', ' | sed 's/,$//' | sed 's/,/, /g')
        fi
        if [[ -n "$db_deps" ]]; then
            fade_content+="- Database: $db_deps"$'\n'
        else
            fade_content+="- Database:"$'\n'
        fi
        fade_content+=""$'\n'
        fade_content+="**Repository:** [link]"$'\n'
        fade_content+=""$'\n'
        fade_content+="---"$'\n'
        fade_content+=""$'\n'

        # Coding Standards section (default template)
        fade_content+="## Coding Standards"$'\n'
        fade_content+=""$'\n'
        fade_content+="<!--"$'\n'
        fade_content+="Define how code should be written in this project. Link to external style guides"$'\n'
        fade_content+="rather than duplicating them. Include project-specific conventions that differ"$'\n'
        fade_content+="from or extend the standard guides."$'\n'
        fade_content+="-->"$'\n'
        fade_content+=""$'\n'
        fade_content+="### Style Guides"$'\n'
        fade_content+=""$'\n'
        fade_content+="- **TypeScript:** [Google TypeScript Style Guide](https://google.github.io/styleguide/tsguide.html)"$'\n'
        fade_content+="- **Python:** [PEP 8](https://peps.python.org/pep-0008/)"$'\n'
        fade_content+="- **API Design:** [JSON:API Specification](https://jsonapi.org/)"$'\n'
        fade_content+=""$'\n'
        fade_content+="### Project Conventions"$'\n'
        fade_content+=""$'\n'
        fade_content+="- Naming: \`camelCase\` for variables, \`PascalCase\` for components"$'\n'
        fade_content+="- Tests: Co-locate with source files as \`*.test.ts\`"$'\n'
        fade_content+="- Commits: Conventional commits format (\`feat:\`, \`fix:\`, \`chore:\`)"$'\n'
        fade_content+=""$'\n'
        fade_content+="---"$'\n'
        fade_content+=""$'\n'

        # Standards section
        fade_content+="## Standards"$'\n'
        fade_content+=""$'\n'
        fade_content+="<!--"$'\n'
        fade_content+="Link to detailed standards documents. These are loaded by Claude when working"$'\n'
        fade_content+="on relevant tasks. Add your own project-specific standards as needed."$'\n'
        fade_content+="-->"$'\n'
        fade_content+=""$'\n'
        fade_content+="| Standard | Description |"$'\n'
        fade_content+="|----------|-------------|"$'\n'
        fade_content+="| [API Security](standards/api-security.md) | Authentication, authorization, input validation, secure error handling |"$'\n'
        fade_content+="| [Git](standards/git.md) | Commit messages, branch naming, FADE-specific conventions |"$'\n'
        fade_content+="| [Coding](standards/coding.md) | Naming, formatting, error handling, code organization |"$'\n'
        fade_content+="| [Testing](standards/testing.md) | Test pyramid, AAA pattern, mocking, coverage requirements |"$'\n'
        fade_content+="| [Documentation](standards/documentation.md) | README structure, API docs, code comments, what NOT to document |"$'\n'
        fade_content+=""$'\n'
        fade_content+="---"$'\n'
        fade_content+=""$'\n'

        # Architecture References section - populated from detected patterns
        fade_content+="## Architecture References"$'\n'
        fade_content+=""$'\n'
        fade_content+="<!--"$'\n'
        fade_content+="Document the high-level architecture and link to detailed design docs."$'\n'
        fade_content+="Include diagrams, ADRs (Architecture Decision Records), or external references."$'\n'
        fade_content+="This helps agents understand where new code should go and how components interact."$'\n'
        fade_content+="-->"$'\n'
        fade_content+=""$'\n'

        # Directory structure if available
        if [[ -n "$dirs" ]]; then
            fade_content+="<!-- AUTO-GENERATED: Directory structure detected from codebase -->"$'\n'
            fade_content+="### Directory Structure"$'\n'
            fade_content+=""$'\n'
            fade_content+="\`\`\`"$'\n'
            fade_content+="$dirs"$'\n'
            fade_content+="\`\`\`"$'\n'
            fade_content+=""$'\n'
        fi

        # Architecture patterns if detected
        if [[ -n "$arch_patterns" ]]; then
            fade_content+="<!-- AUTO-GENERATED: Architecture patterns detected from codebase -->"$'\n'
            fade_content+="### Detected Patterns"$'\n'
            fade_content+=""$'\n'
            fade_content+="| Pattern | Confidence | Evidence |"$'\n'
            fade_content+="|---------|------------|----------|"$'\n'
            while IFS='|' read -r pattern confidence evidence; do
                fade_content+="| $pattern | $confidence | $evidence |"$'\n'
            done <<< "$arch_patterns"
            fade_content+=""$'\n'
        fi

        fade_content+="### Key Documents"$'\n'
        fade_content+=""$'\n'
        fade_content+="| Document | Location | Description |"$'\n'
        fade_content+="|----------|----------|-------------|"$'\n'
        fade_content+="| API Design | \`docs/api.md\` | REST endpoint specifications |"$'\n'
        fade_content+="| Data Model | \`docs/schema.md\` | Database schema and relationships |"$'\n'
        fade_content+="| Auth Flow | \`docs/auth.md\` | Authentication and authorization |"$'\n'
        fade_content+=""$'\n'
        fade_content+="---"$'\n'
        fade_content+=""$'\n'

        # Key Dependencies section if dependencies detected
        if [[ -n "$deps" ]]; then
            local dep_summary_for_file
            dep_summary_for_file=$(format_dependencies_summary "$deps")
            if [[ -n "$dep_summary_for_file" ]]; then
                fade_content+="<!-- AUTO-GENERATED: Dependencies detected from manifest files -->"$'\n'
                fade_content+="## Key Dependencies"$'\n'
                fade_content+=""$'\n'
                fade_content+="$dep_summary_for_file"$'\n'
                fade_content+=""$'\n'
                fade_content+="---"$'\n'
                fade_content+=""$'\n'
            fi
        fi

        # Target Architecture section (template)
        fade_content+="## Target Architecture"$'\n'
        fade_content+=""$'\n'
        fade_content+="<!--"$'\n'
        fade_content+="Where we're heading. Bias toward these patterns in all work, even when"$'\n'
        fade_content+="the current PRD doesn't directly address them. Remove items when achieved."$'\n'
        fade_content+="-->"$'\n'
        fade_content+=""$'\n'
        fade_content+="- Example: Stateless JWT auth (moving away from sessions)"$'\n'
        fade_content+="- Example: All writes through service layer (no direct DB in routes)"$'\n'
        fade_content+="- Example: Config-driven values (no hardcoding)"$'\n'
        fade_content+=""$'\n'
        fade_content+="---"$'\n'
        fade_content+=""$'\n'

        # Fragile Areas section (populated from detection or template)
        fade_content+="## Fragile Areas"$'\n'
        fade_content+=""$'\n'
        fade_content+="<!--"$'\n'
        fade_content+="Known problem spots. Exercise extra caution here - smaller commits, more"$'\n'
        fade_content+="verification, ask before major refactoring. Remove when cleaned up."$'\n'
        fade_content+="-->"$'\n'
        fade_content+=""$'\n'
        fade_content+="| Area | Why it's fragile |"$'\n'
        fade_content+="|------|------------------|"$'\n'

        if [[ -n "$fragile_areas" ]]; then
            # Use detected fragile areas
            fade_content+="<!-- AUTO-GENERATED: Potential fragile areas detected from codebase -->"$'\n'
            while IFS='|' read -r path reason severity; do
                fade_content+="| \`$path\` | $reason |"$'\n'
            done <<< "$fragile_areas"
        else
            # Fall back to template examples
            fade_content+="| \`example/path/\` | Example: Changes cascade unpredictably |"$'\n'
            fade_content+="| \`another/module.py\` | Example: Looks simple, always takes 5x longer |"$'\n'
        fi
        fade_content+=""$'\n'
        fade_content+="---"$'\n'
        fade_content+=""$'\n'

        # Off-Limits Modules section (template)
        fade_content+="## Off-Limits Modules"$'\n'
        fade_content+=""$'\n'
        fade_content+="<!--"$'\n'
        fade_content+="List modules, files, or directories that agents should NOT modify."$'\n'
        fade_content+="Common reasons: legacy code pending rewrite, external vendor code,"$'\n'
        fade_content+="security-sensitive modules requiring human review, or code with"$'\n'
        fade_content+="complex implicit dependencies."$'\n'
        fade_content+=""$'\n'
        fade_content+="Note: For areas that are risky but not forbidden, see **Fragile Areas** above."$'\n'
        fade_content+="-->"$'\n'
        fade_content+=""$'\n'
        fade_content+="| Path | Reason | Contact |"$'\n'
        fade_content+="|------|--------|---------|"$'\n'
        fade_content+="| \`src/legacy/\` | Legacy code scheduled for rewrite in Q2 | @backend-team |"$'\n'
        fade_content+="| \`src/auth/crypto.ts\` | Security-critical, requires human review | @security |"$'\n'
        fade_content+="| \`vendor/\` | Third-party code, do not modify | n/a |"$'\n'
        fade_content+=""$'\n'
        fade_content+="**If you need to modify an off-limits module:** Stop and ask the human for guidance."$'\n'
        fade_content+=""$'\n'
        fade_content+="---"$'\n'
        fade_content+=""$'\n'

        # Session Boundaries section (template)
        fade_content+="## Session Boundaries"$'\n'
        fade_content+=""$'\n'
        fade_content+="<!--"$'\n'
        fade_content+="Define constraints for AI coding sessions. This helps agents understand"$'\n'
        fade_content+="what they can and cannot do, and when to ask for human input."$'\n'
        fade_content+="-->"$'\n'
        fade_content+=""$'\n'
        fade_content+="### Allowed Actions"$'\n'
        fade_content+=""$'\n'
        fade_content+="- Create, modify, delete files in \`src/\`, \`tests/\`, \`docs/\`"$'\n'
        fade_content+="- Run tests and linters"$'\n'
        fade_content+="- Install dev dependencies"$'\n'
        fade_content+="- Create feature branches"$'\n'
        fade_content+=""$'\n'
        fade_content+="### Requires Human Approval"$'\n'
        fade_content+=""$'\n'
        fade_content+="- Changes to CI/CD configuration (\`.github/\`, \`Dockerfile\`)"$'\n'
        fade_content+="- Database migrations"$'\n'
        fade_content+="- Changes to authentication or authorization logic"$'\n'
        fade_content+="- Dependency upgrades (major versions)"$'\n'
        fade_content+="- Deleting more than 5 files in one session"$'\n'
        fade_content+=""$'\n'
        fade_content+="### Never Do"$'\n'
        fade_content+=""$'\n'
        fade_content+="- Push directly to \`main\` or \`master\`"$'\n'
        fade_content+="- Modify \`.env\` files or commit secrets"$'\n'
        fade_content+="- Run destructive database commands in production"$'\n'
        fade_content+="- Disable security features or linters"$'\n'
        fade_content+=""$'\n'
        fade_content+="---"$'\n'
        fade_content+=""$'\n'

        # System Context section (template)
        fade_content+="## System Context"$'\n'
        fade_content+=""$'\n'
        fade_content+="<!--"$'\n'
        fade_content+="Provide awareness of where this work fits in the broader project landscape."$'\n'
        fade_content+="This helps agents understand sequencing, dependencies, and what else is happening."$'\n'
        fade_content+="-->"$'\n'
        fade_content+=""$'\n'
        fade_content+="### Current Challenges"$'\n'
        fade_content+=""$'\n'
        fade_content+="<!--"$'\n'
        fade_content+="What problems or constraints is the team currently dealing with?"$'\n'
        fade_content+="Examples: technical debt, scaling issues, team transitions, deadline pressure"$'\n'
        fade_content+="-->"$'\n'
        fade_content+=""$'\n'
        fade_content+="- Challenge 1: description"$'\n'
        fade_content+="- Challenge 2: description"$'\n'
        fade_content+=""$'\n'
        fade_content+="### Transition Plan"$'\n'
        fade_content+=""$'\n'
        fade_content+="<!--"$'\n'
        fade_content+="If the project is undergoing a migration, refactor, or multi-phase initiative,"$'\n'
        fade_content+="document the phases here. Use status indicators:"$'\n'
        fade_content+="  - Link to doc (if detailed plan exists elsewhere)"$'\n'
        fade_content+="  - NOT WRITTEN (planned but not documented)"$'\n'
        fade_content+="  - ✅ COMPLETE (done)"$'\n'
        fade_content+="  - ← CURRENT (active phase)"$'\n'
        fade_content+="-->"$'\n'
        fade_content+=""$'\n'
        fade_content+="| Phase | Description | Status |"$'\n'
        fade_content+="|-------|-------------|--------|"$'\n'
        fade_content+="| Phase 1 | Description | ✅ COMPLETE |"$'\n'
        fade_content+="| Phase 2 | Description | ← CURRENT |"$'\n'
        fade_content+="| Phase 3 | Description | NOT WRITTEN |"$'\n'
        fade_content+=""$'\n'
        fade_content+="### Active Work Items"$'\n'
        fade_content+=""$'\n'
        fade_content+="<!--"$'\n'
        fade_content+="What else is in flight? This helps agents avoid conflicts and understand priorities."$'\n'
        fade_content+="Include different work types: features, bugs, chores, spikes"$'\n'
        fade_content+="Format: [TYPE] Brief description - Owner/Status"$'\n'
        fade_content+="-->"$'\n'
        fade_content+=""$'\n'
        fade_content+="- [FEATURE] Example feature being built - @developer / in progress"$'\n'
        fade_content+="- [BUG] Example bug being investigated - @developer / blocked"$'\n'
        fade_content+="- [CHORE] Example operational task - unassigned"$'\n'
        fade_content+="- [SPIKE] Example research/investigation - @developer / complete"$'\n'
        fade_content+=""$'\n'
        fade_content+="---"$'\n'
        fade_content+=""$'\n'

        # Development Environment section (template)
        fade_content+="## Development Environment"$'\n'
        fade_content+=""$'\n'
        fade_content+="### Local Development"$'\n'
        fade_content+=""$'\n'
        fade_content+="- How to run locally"$'\n'
        fade_content+="- Required environment variables"$'\n'
        fade_content+="- Test commands"$'\n'
        fade_content+=""$'\n'
        fade_content+="### Production/Deployment"$'\n'
        fade_content+=""$'\n'
        fade_content+="- Deployment process"$'\n'
        fade_content+="- Production environment details"$'\n'
        fade_content+=""$'\n'
        fade_content+="---"$'\n'
        fade_content+=""$'\n'

        # Additional Context section (template)
        fade_content+="## Additional Context"$'\n'
        fade_content+=""$'\n'
        fade_content+="<!--"$'\n'
        fade_content+="Add any other information that helps agents work effectively:"$'\n'
        fade_content+="- Known gotchas or quirks"$'\n'
        fade_content+="- Recent major changes"$'\n'
        fade_content+="- Upcoming planned changes that affect current work"$'\n'
        fade_content+="-->"$'\n'

        # Write the file
        echo "$fade_content" > FADE.md

        echo -e "${GREEN}✓ Created FADE.md${NC}"
        echo ""
        echo -e "${YELLOW}⚠️  IMPORTANT: Review and customize FADE.md${NC}"
        echo ""
        echo "The following sections were auto-generated and should be reviewed:"
        echo "  - Project Overview: Add a description of your project"
        echo "  - Tech Stack: Verify detected languages/frameworks are correct"
        if [[ -n "$arch_patterns" ]]; then
            echo "  - Architecture References: Review detected patterns"
        fi
        if [[ -n "$deps" ]]; then
            echo "  - Key Dependencies: Verify categorization is accurate"
        fi
        echo "  - Off-Limits Modules: Update with your actual off-limits paths"
        if [[ -n "$fragile_areas" ]]; then
            echo "  - Fragile Areas: Review detected problem spots, add any missing"
        else
            echo "  - Fragile Areas: Add known problem spots"
        fi
        echo "  - Session Boundaries: Customize allowed/forbidden actions"
        echo ""
        echo "Look for <!-- AUTO-GENERATED --> comments to find sections that need review."
        echo ""
        echo "Run 'fade init' to create the full FADE structure (prds/, standards/, etc.)."
    else
        echo -e "${GREEN}✓ Map complete${NC}"
        echo ""
        echo "Review the output above and paste relevant sections into FADE.md."
        echo "Run 'fade map --init' to generate a draft FADE.md automatically."
    fi
}

# ============================================================================
# MAIN
# ============================================================================

case "${1:-}" in
    init)
        cmd_init
        ;;
    new)
        shift
        cmd_new "$@"
        ;;
    run)
        shift
        cmd_run "$@"
        ;;
    yolo)
        shift
        cmd_yolo "$@"
        ;;
    quick)
        shift
        cmd_quick "$@"
        ;;
    discover)
        shift
        cmd_discover "$@"
        ;;
    classify)
        cmd_classify
        ;;
    dashboard)
        shift
        cmd_dashboard "$@"
        ;;
    status)
        shift
        cmd_status "$@"
        ;;
    update)
        shift
        cmd_update "$@"
        ;;
    export)
        cmd_export
        ;;
    map)
        shift
        cmd_map "$@"
        ;;
    migrate)
        shift
        cmd_migrate "$@"
        ;;
    version|--version|-v)
        shift
        cmd_version "$@"
        ;;
    help|--help|-h)
        cmd_help
        ;;
    "")
        cmd_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo "Run 'fade help' for usage."
        exit 1
        ;;
esac
