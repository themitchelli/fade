read -r -d '' PROMPT_TEMPLATE << 'EOF' || true
<!-- FADE prompt.md v__FADE_VERSION__ -->

# FADE Execution Prompt

You are an AI developer working within the FADE (Framework for Agentic Development and Engineering) system. Your job is to implement user stories from PRD files while maintaining session continuity.

---

## Session Start

1. Read `FADE.md` for project context, standards, and boundaries
   - Check **System Context** to understand where this work fits
   - Check **Transition Plan** for sequencing
   - Check **Active Work Items** to avoid conflicts
2. Read `progress.md` to see what's been completed
3. Read `learned.md` for discoveries from previous sessions
4. Find the active PRD (see **PRD Discovery** below)
5. Pick the highest priority story where `passes: false`

## PRD Discovery

### Priority Order
1. **`prd.json`** in root - Priority injection (critical bugs, urgent work)
2. **`prds/*.json`** - Standard queue, lowest number first

### Naming Convention
PRD files in `prds/` follow: `{TYPE}-{NUMBER}-{slug}.json`

| Type | Description |
|------|-------------|
| FEAT | Feature |
| BUG | Bug fix |
| CHORE | Operational/maintenance work |
| ENH | Enhancement |
| SPIKE | Exploration |

### Selection Logic
1. If `prd.json` exists with incomplete stories → use it
2. Otherwise, pick lowest-numbered PRD in `prds/` with incomplete stories
3. Within PRD, pick highest priority story where `passes: false`

## Execution Rules

- **One story at a time** - Complete fully before signalling done
- **Follow standards** in FADE.md
- **Respect boundaries** - don't touch off-limits modules
- **Small commits** - working increments, not big bangs
- **Test before done** - all acceptance criteria must pass

## Git Conventions

| Prefix | Use |
|--------|-----|
| `feat:` | New feature |
| `fix:` | Bug fix |
| `docs:` | Documentation |
| `chore:` | Maintenance, dependencies, operational |
| `refactor:` | Code restructure, no behaviour change |
| `spike:` | Exploratory (spike branches only) |

## Spike Execution

If PRD has `"type": "spike"`:
1. Create branch: `git checkout -b {branchName}`
2. All work stays on spike branch
3. Create the `outputArtifact`
4. Do NOT merge to main

## Story Completion Protocol

After completing a story, you MUST do these steps IN ORDER:

### Step 1: Update progress.md
Append:
```
## YYYY-MM-DD HH:MM - US-XXX: Story Title - COMPLETE

- Summary of implementation
- Files changed: [list]
- Tests: passed/added
```

### Step 2: Update learned.md (if applicable)
Only add genuinely reusable, non-obvious discoveries.

### Step 3: Update PRD
Set `passes: true` for the completed story.

### Step 4: Commit everything
```bash
git add -A && git commit -m "feat: complete US-XXX - Story Title"
```

### Step 5: Signal completion

Check if there are more incomplete stories in the queue:
- If MORE work remains: Output exactly `STORY_DONE: US-XXX`
- If ALL work complete: Output exactly `ALL_COMPLETE`

### Step 6: STOP

After outputting the signal, STOP IMMEDIATELY.
- Do NOT continue to the next story
- Do NOT respond to follow-up questions
- Your process will exit

An external orchestrator will either:
- Restart you with fresh context (ALL mode)
- Wait for human to run `fade run` again (STOP mode)

The files you updated ARE the memory for the next session.

## Exit Signals (Canonical Reference)

These are the ONLY valid exit signals. The fade script detects these to control loop behavior.

| Signal | Format | Meaning | Loop Action |
|--------|--------|---------|-------------|
| STORY_DONE | `STORY_DONE: US-XXX` | One story completed, more work remains | Continue to next iteration |
| ALL_COMPLETE | `ALL_COMPLETE` | All stories in queue finished | Exit loop successfully |
| BLOCKED | `BLOCKED: [reason]` | Cannot proceed, human intervention needed | Exit loop, await human |

**Important:** Output signals exactly as shown. The fade script uses simple string matching.

## Error Handling

If blocked:
1. Document in progress.md as BLOCKED entry
2. Commit the documentation
3. Output exactly: `BLOCKED: [reason]`
4. STOP - wait for human intervention

## File Locations

### Contained Structure (New)
```
./FADE.md           # Project context (read-only)
./CLAUDE.md         # Redirect for Claude Code
./fade/
  ├── prompt.md     # Execution instructions
  ├── progress.md   # Session history (append-only)
  ├── learned.md    # Cumulative memory (append-only)
  ├── prd.json      # Priority PRD (optional)
  ├── prds/         # PRD queue
  └── prd-archive/  # Completed PRDs
```

### Legacy Structure (Backwards Compatible)
```
./FADE.md       # Project context (read-only)
./prompt.md     # Execution instructions
./progress.md   # Session history (append-only)
./learned.md    # Cumulative memory (append-only)
./prd.json      # Priority PRD (optional)
./prds/         # PRD queue
./prd-archive/  # Completed PRDs
```

The fade script checks both locations, preferring the contained structure (`fade/`) when present.

---

Now: Read context files, pick the next story, and begin.
EOF

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

create_file_if_missing() {
    local file="$1"
    local content="$2"

    if [[ -f "$file" ]]; then
        echo -e "  ${YELLOW}skip${NC}: $file (already exists)"
        return 1
    else
        # Replace version placeholder with actual version
        content="${content//__FADE_VERSION__/$FADE_VERSION}"
        echo "$content" > "$file"
        echo -e "  ${GREEN}create${NC}: $file"
        return 0
    fi
}

# Check if a PRD has incomplete stories
prd_has_incomplete_stories() {
    local prd_file="$1"
    if [[ ! -f "$prd_file" ]]; then
        return 1
    fi

    # Count total stories and complete stories
    # A story is incomplete if passes:false OR missing passes field entirely
    local total_stories
    local complete_stories
    total_stories=$(grep -c '"id"[[:space:]]*:[[:space:]]*"US-' "$prd_file" 2>/dev/null) || total_stories=0
    complete_stories=$(grep -c '"passes"[[:space:]]*:[[:space:]]*true' "$prd_file" 2>/dev/null) || complete_stories=0

    # Has incomplete if total > complete (catches both passes:false AND missing passes)
    if [[ "$total_stories" -gt "$complete_stories" ]]; then
        return 0
    fi
    return 1
}

# Extract PRD name/title from JSON file
get_prd_name() {
    local prd_file="$1"
    local name=""
    
    name=$(grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' "$prd_file" 2>/dev/null | head -1 | sed 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
    
    if [[ -z "$name" ]]; then
        name=$(grep -o '"title"[[:space:]]*:[[:space:]]*"[^"]*"' "$prd_file" 2>/dev/null | head -1 | sed 's/.*"title"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
    fi
    
    if [[ -z "$name" ]]; then
        name=$(basename "$prd_file" .json)
    fi
    
    echo "$name"
}

# Get PRD type from JSON or filename
get_prd_type() {
    local prd_file="$1"
    local prd_type=""
    
    prd_type=$(grep -o '"type"[[:space:]]*:[[:space:]]*"[^"]*"' "$prd_file" 2>/dev/null | head -1 | sed 's/.*"type"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
    
    if [[ -z "$prd_type" ]]; then
        local filename=$(basename "$prd_file")
        prd_type=$(echo "$filename" | grep -o '^[A-Z]*' | head -1)
    fi
    
    echo "$prd_type"
}

# Count incomplete stories in a PRD
# A story is incomplete if passes:false OR missing passes field entirely
count_incomplete_stories() {
    local prd_file="$1"
    local total_stories
    local complete_stories
    total_stories=$(grep -c '"id"[[:space:]]*:[[:space:]]*"US-' "$prd_file" 2>/dev/null) || total_stories=0
    complete_stories=$(grep -c '"passes"[[:space:]]*:[[:space:]]*true' "$prd_file" 2>/dev/null) || complete_stories=0
    echo $((total_stories - complete_stories))
}

# Count complete stories in a PRD
# Only counts stories with EXPLICIT passes:true (missing passes field = incomplete)
count_complete_stories() {
    local prd_file="$1"
    local count
    count=$(grep -c '"passes"[[:space:]]*:[[:space:]]*true' "$prd_file" 2>/dev/null) || count=0
    echo "$count"
}

# Extract version from FADE artifact file (reads first line for <!-- FADE {filename} vX.X.X -->)
get_artifact_version() {
    local file="$1"
    if [[ ! -f "$file" ]]; then
        echo ""
        return
    fi
    # Look for <!-- FADE {filename} vX.X.X --> pattern in first line (new format)
    # Also supports legacy <!-- FADE vX.X.X --> format for backwards compatibility
    local version
    version=$(head -1 "$file" | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1 | sed 's/v//' 2>/dev/null) || version=""
    echo "$version"
}

# Get the active PRD (priority prd.json or first incomplete in prds/)
# Checks fade/ directory first, falls back to root for backwards compatibility
get_active_prd() {
    # Check fade/prd.json first (new contained structure)
    if [[ -f "fade/prd.json" ]] && prd_has_incomplete_stories "fade/prd.json"; then
        echo "fade/prd.json"
        return
    fi

    # Fall back to root prd.json (legacy structure)
    if [[ -f "prd.json" ]] && prd_has_incomplete_stories "prd.json"; then
        echo "prd.json"
        return
    fi

    # Check fade/prds/ first (new contained structure)
    if [[ -d "fade/prds" ]]; then
        for prd_file in $(ls fade/prds/*.json 2>/dev/null | sort); do
            [[ -f "$prd_file" ]] || continue
            if prd_has_incomplete_stories "$prd_file"; then
                echo "$prd_file"
                return
            fi
        done
    fi

    # Fall back to root prds/ (legacy structure)
    if [[ -d "prds" ]]; then
        for prd_file in $(ls prds/*.json 2>/dev/null | sort); do
            [[ -f "$prd_file" ]] || continue
            if prd_has_incomplete_stories "$prd_file"; then
                echo "$prd_file"
                return
            fi
        done
    fi
}

# Get story title from PRD by story ID
get_story_title() {
    local prd_file="$1"
    local story_id="$2"

    if [[ ! -f "$prd_file" ]]; then
        return
    fi

    # Use awk to extract title for the matching story ID
    awk -v id="$story_id" '
        /"id"[[:space:]]*:[[:space:]]*"'"$story_id"'"/ { found=1 }
        found && /"title"[[:space:]]*:/ {
            gsub(/.*"title"[[:space:]]*:[[:space:]]*"/, "")
            gsub(/".*/, "")
            print
            exit
        }
    ' "$prd_file"
}

# Get acceptance criteria for a story from PRD
get_story_acceptance_criteria() {
    local prd_file="$1"
    local story_id="$2"

    if [[ ! -f "$prd_file" ]]; then
        return
    fi

    # Use awk to extract acceptance criteria array for the matching story
    awk -v id="$story_id" '
        /"id"[[:space:]]*:[[:space:]]*"'"$story_id"'"/ { found=1 }
        found && /"acceptanceCriteria"[[:space:]]*:/ { in_criteria=1; next }
        in_criteria && /\]/ { exit }
        in_criteria && /"[^"]+"/  {
            gsub(/^[[:space:]]*"/, "")
            gsub(/"[[:space:]]*,?[[:space:]]*$/, "")
            print
        }
    ' "$prd_file"
}

# Get latest git commit message
get_latest_commit_message() {
    git log -1 --pretty=format:"%s" 2>/dev/null || echo "No commits found"
}

# Display learned.md changes if any were detected
# Takes before_content_file (temp file path) as argument
# Checks fade/ directory first, falls back to root for backwards compatibility
display_learned_changes() {
    local before_file="$1"

    # Determine learned.md path (prefer fade/ if exists, fall back to root)
    local learned_path=""
    if [[ -f "fade/learned.md" ]]; then
        learned_path="fade/learned.md"
    elif [[ -f "learned.md" ]]; then
        learned_path="learned.md"
    fi

    # If no before file provided or learned.md doesn't exist, skip
    if [[ -z "$before_file" ]] || [[ -z "$learned_path" ]]; then
        return
    fi

    # Compare before and after using diff
    local diff_output=$(diff "$before_file" "$learned_path" 2>/dev/null | grep '^>' | sed 's/^> //')

    # If no changes, display nothing (no noise)
    if [[ -z "$diff_output" ]]; then
        return
    fi

    # learned.md was modified, show the new entries
    echo -e "${YELLOW}New Learnings Captured:${NC}"
    echo ""
    echo "$diff_output" | while IFS= read -r line; do
        if [[ -n "$line" ]]; then
            echo -e "  ${GREEN}+${NC} $line"
        fi
    done
    echo ""
}

# Check if a PRD is fully complete (all stories have passes: true)
# Requires EXPLICIT passes:true on ALL stories - missing passes field = incomplete
prd_is_fully_complete() {
    local prd_file="$1"
    if [[ ! -f "$prd_file" ]]; then
        return 1
    fi

    # A PRD is fully complete if it has at least one story AND all stories have passes:true
    local total_stories
    local complete_stories
    total_stories=$(grep -c '"id"[[:space:]]*:[[:space:]]*"US-' "$prd_file" 2>/dev/null) || total_stories=0
    complete_stories=$(grep -c '"passes"[[:space:]]*:[[:space:]]*true' "$prd_file" 2>/dev/null) || complete_stories=0

    if [[ "$total_stories" -gt 0 && "$total_stories" -eq "$complete_stories" ]]; then
        return 0
    fi
    return 1
}

# Archive completed PRDs from prds/ folder
# Checks fade/ directory first, falls back to root for backwards compatibility
# Returns the number of files archived
archive_completed_prds() {
    local archived_count=0

    # Determine archive path (prefer fade/ if prds exists there, else root)
    local archive_path="prd-archive"
    local prds_path="prds"
    if [[ -d "fade/prds" ]]; then
        archive_path="fade/prd-archive"
        prds_path="fade/prds"
    fi

    # Ensure archive folder exists
    if [[ ! -d "$archive_path" ]]; then
        mkdir -p "$archive_path"
        touch "$archive_path/.gitkeep"
    fi

    # Scan prds folder for completed PRDs
    if [[ -d "$prds_path" ]]; then
        for prd_file in "$prds_path"/*.json; do
            [[ -f "$prd_file" ]] || continue

            if prd_is_fully_complete "$prd_file"; then
                local filename=$(basename "$prd_file")

                # Re-verify completion immediately before move to prevent race conditions
                # This catches cases where file was modified between initial check and archive
                if ! prd_is_fully_complete "$prd_file"; then
                    echo -e "  ${YELLOW}warning${NC}: $filename - archive aborted, PRD no longer complete"
                    continue
                fi

                mv "$prd_file" "$archive_path/$filename"

                # Verify source file no longer exists after move
                if [[ -f "$prd_file" ]]; then
                    echo -e "  ${RED}error${NC}: $filename - source file still exists after move, archive aborted"
                    # Remove the partial archive if it exists
                    rm -f "$archive_path/$filename"
                    continue
                fi

                echo -e "  ${GREEN}archived${NC}: $filename"
                ((archived_count++))
            fi
        done
    fi

    echo "$archived_count"
}

# Convert PRD type field value to standard TYPE prefix
# feature→FEAT, bug→BUG, enhancement→ENH, chore→CHORE, spike→SPIKE
convert_type_to_prefix() {
    local type_value="$1"
    local type_lower=$(echo "$type_value" | tr '[:upper:]' '[:lower:]')

    case "$type_lower" in
        feature|feat)
            echo "FEAT"
            ;;
        bug)
            echo "BUG"
            ;;
        enhancement|enh)
            echo "ENH"
            ;;
        chore)
            echo "CHORE"
            ;;
        spike)
            echo "SPIKE"
            ;;
        *)
            # If already uppercase prefix format, use as-is
            echo "$type_value" | tr '[:lower:]' '[:upper:]'
            ;;
    esac
}

# Generate slug from name: lowercase, spaces to hyphens, max 50 chars
generate_slug() {
    local name="$1"
    local slug

    # Lowercase, replace spaces with hyphens, remove non-alphanumeric except hyphens
    slug=$(echo "$name" | tr '[:upper:]' '[:lower:]' | sed 's/[[:space:]]/-/g' | sed 's/[^a-z0-9-]//g' | sed 's/--*/-/g' | sed 's/^-//' | sed 's/-$//')

    # Truncate to max 50 chars
    if [[ ${#slug} -gt 50 ]]; then
        slug="${slug:0:50}"
        # Avoid trailing hyphen after truncation
        slug=$(echo "$slug" | sed 's/-$//')
    fi

    echo "$slug"
}

# Get PRD ID from JSON file
get_prd_id() {
    local prd_file="$1"
    grep -o '"id"[[:space:]]*:[[:space:]]*"[^"]*"' "$prd_file" 2>/dev/null | head -1 | sed 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/'
}

# Archive prd.json with standard naming convention
# Checks fade/ directory first, falls back to root for backwards compatibility
# If prd.json exists and is fully complete, rename and move to prd-archive/
# Returns 1 if archived, 0 otherwise
archive_priority_prd() {
    # Determine prd.json location (prefer fade/ if exists)
    local prd_path=""
    local archive_path=""
    if [[ -f "fade/prd.json" ]]; then
        prd_path="fade/prd.json"
        archive_path="fade/prd-archive"
    elif [[ -f "prd.json" ]]; then
        prd_path="prd.json"
        archive_path="prd-archive"
    else
        return 0
    fi

    if ! prd_is_fully_complete "$prd_path"; then
        return 0
    fi

    # Ensure archive folder exists
    if [[ ! -d "$archive_path" ]]; then
        mkdir -p "$archive_path"
        touch "$archive_path/.gitkeep"
    fi

    # Extract metadata for naming
    local prd_type=$(get_prd_type "$prd_path")
    local prd_id=$(get_prd_id "$prd_path")
    local prd_name=$(get_prd_name "$prd_path")

    # Generate slug from name
    local slug=$(generate_slug "$prd_name")

    # Build filename
    # If ID already contains type prefix (e.g., BUG-009), use {ID}-{slug}.json
    # Otherwise use {TYPE}-{ID}-{slug}.json
    local new_filename
    if [[ "$prd_id" =~ ^[A-Z]+-[0-9]+$ ]]; then
        # ID already has TYPE-NUMBER format
        new_filename="${prd_id}-${slug}.json"
    else
        # ID is just a number, prepend type prefix
        local type_prefix=$(convert_type_to_prefix "$prd_type")
        new_filename="${type_prefix}-${prd_id}-${slug}.json"
    fi

    # Re-verify completion immediately before move to prevent race conditions
    if ! prd_is_fully_complete "$prd_path"; then
        echo -e "  ${YELLOW}warning${NC}: prd.json - archive aborted, PRD no longer complete"
        echo "0"
        return 0
    fi

    # Move to archive with new name
    mv "$prd_path" "$archive_path/$new_filename"

    # Verify source file no longer exists after move
    if [[ -f "$prd_path" ]]; then
        echo -e "  ${RED}error${NC}: $(basename "$prd_path") - source file still exists after move, archive aborted"
        # Remove the partial archive if it exists
        rm -f "$archive_path/$new_filename"
        echo "0"
        return 0
    fi

    echo -e "  ${GREEN}archived${NC}: $(basename "$prd_path") → $new_filename"

    echo "1"
}

# Get total story counts across all PRDs with incomplete work
# Checks fade/ directory first, falls back to root for backwards compatibility
get_total_progress() {
    local total_complete=0
    local total_stories=0

    # Check fade/prd.json first (new contained structure)
    if [[ -f "fade/prd.json" ]] && prd_has_incomplete_stories "fade/prd.json"; then
        local complete=$(count_complete_stories "fade/prd.json")
        local incomplete=$(count_incomplete_stories "fade/prd.json")
        ((total_complete += complete))
        ((total_stories += complete + incomplete))
    # Fall back to root prd.json (legacy structure)
    elif [[ -f "prd.json" ]] && prd_has_incomplete_stories "prd.json"; then
        local complete=$(count_complete_stories "prd.json")
        local incomplete=$(count_incomplete_stories "prd.json")
        ((total_complete += complete))
        ((total_stories += complete + incomplete))
    fi

    # Check fade/prds/ first (new contained structure)
    if [[ -d "fade/prds" ]]; then
        for prd_file in $(ls fade/prds/*.json 2>/dev/null | sort); do
            [[ -f "$prd_file" ]] || continue
            if prd_has_incomplete_stories "$prd_file"; then
                local complete=$(count_complete_stories "$prd_file")
                local incomplete=$(count_incomplete_stories "$prd_file")
                ((total_complete += complete))
                ((total_stories += complete + incomplete))
            fi
        done
    fi

    # Fall back to root prds/ (legacy structure)
    if [[ -d "prds" ]]; then
        for prd_file in $(ls prds/*.json 2>/dev/null | sort); do
            [[ -f "$prd_file" ]] || continue
            if prd_has_incomplete_stories "$prd_file"; then
                local complete=$(count_complete_stories "$prd_file")
                local incomplete=$(count_incomplete_stories "$prd_file")
                ((total_complete += complete))
                ((total_stories += complete + incomplete))
            fi
        done
    fi

    echo "$total_complete $total_stories"
}

# Display story-level status for the active PRD with checkboxes
display_prd_stories() {
    local prd_file="$1"

    if [[ ! -f "$prd_file" ]]; then
        return
    fi

    local prd_name=$(get_prd_name "$prd_file")

    echo -e "${BOLD}$prd_name${NC}"
    echo ""

    # Extract stories with their status using awk
    # Output format: ID|TITLE|PASSES
    awk '
        /"userStories"/ { in_stories=1 }
        in_stories && /"id"[[:space:]]*:/ {
            gsub(/.*"id"[[:space:]]*:[[:space:]]*"/, "")
            gsub(/".*/, "")
            story_id = $0
        }
        in_stories && /"title"[[:space:]]*:/ {
            gsub(/.*"title"[[:space:]]*:[[:space:]]*"/, "")
            gsub(/".*/, "")
            story_title = $0
        }
        in_stories && /"passes"[[:space:]]*:/ {
            if (/true/) {
                passes = "true"
            } else {
                passes = "false"
            }
            print story_id "|" story_title "|" passes
            story_id = ""
            story_title = ""
            passes = ""
        }
    ' "$prd_file" | while IFS='|' read -r id title passes; do
        if [[ "$passes" == "true" ]]; then
            echo -e "  ${GREEN}[✓]${NC} $id: $title"
        else
            echo -e "  ${RED}[ ]${NC} $id: $title"
        fi
    done
}

# ============================================================================
# INTERRUPTION HANDLING
# ============================================================================
# Functions for detecting and handling known interruption patterns (non-error exits)

# Check for known interruption patterns in output
# Returns: "rate_limit", "network_error", "service_error", or "" (no interruption)
detect_interruption() {
    local output="$1"

    # Rate limit: Claude's usage limit message
    if echo "$output" | grep -qi "You've hit your limit"; then
        echo "rate_limit"
        return 0
    fi

    # Network errors: connection issues
    if echo "$output" | grep -qi "connection refused\|network.*unreachable\|could not resolve host\|connection timed out"; then
        echo "network_error"
        return 0
    fi

    # Service errors: Claude API issues
    if echo "$output" | grep -qi "service.*unavailable\|internal server error\|503\|502\|overloaded"; then
        echo "service_error"
        return 0
    fi

    # No known interruption detected
    echo ""
}

# Display session context (used by all interruption handlers)
display_session_context() {
    local active_prd=$(get_active_prd)
    local prd_name=""
    local incomplete_count=0

    if [[ -n "$active_prd" ]]; then
        prd_name=$(get_prd_name "$active_prd")
        incomplete_count=$(count_incomplete_stories "$active_prd")

        echo -e "${CYAN}Current work:${NC}"
        echo -e "  PRD: $prd_name"
        echo -e "  Remaining: $incomplete_count story(ies)"
        echo ""
    fi
}

# Display resume instructions (used by all interruption handlers)
display_resume_instructions() {
    echo -e "${CYAN}To resume:${NC}"
    echo -e "  fade run       # Resume with mode selection"
    echo -e "  fade yolo      # Resume in full auto mode"
    echo ""
    echo -e "Your progress has been saved. Pick up where you left off when ready."
    echo ""
}

# Display rate limit exit message
display_rate_limit_exit() {
    local output="$1"

    # Try to extract reset time from output (format: "resets Xam/pm (timezone)")
    local reset_time=""
    reset_time=$(echo "$output" | grep -oi "resets [0-9]*[ap]m[^)]*)" | head -1)

    echo ""
    echo -e "${YELLOW}════════════════════════════════════════════════════════════${NC}"
    echo -e "${YELLOW}⏸️  Session Paused - Rate Limit Reached${NC}"
    echo -e "${YELLOW}════════════════════════════════════════════════════════════${NC}"
    echo ""
    echo -e "Claude has reached its usage limit for this session."
    echo ""

    if [[ -n "$reset_time" ]]; then
        echo -e "${CYAN}Reset time:${NC} $reset_time"
        echo ""
    fi

    display_session_context
    display_resume_instructions
}

# Display network error exit message
display_network_error_exit() {
    echo ""
    echo -e "${YELLOW}════════════════════════════════════════════════════════════${NC}"
    echo -e "${YELLOW}⏸️  Session Paused - Network Issue${NC}"
    echo -e "${YELLOW}════════════════════════════════════════════════════════════${NC}"
    echo ""
    echo -e "A network error occurred during the session."
    echo -e "This may be a temporary connectivity issue."
    echo ""

    display_session_context

    echo -e "${CYAN}Suggestions:${NC}"
    echo -e "  • Check your internet connection"
    echo -e "  • Try again in a few moments"
    echo ""

    display_resume_instructions
}

# Display service error exit message
display_service_error_exit() {
    echo ""
    echo -e "${YELLOW}════════════════════════════════════════════════════════════${NC}"
    echo -e "${YELLOW}⏸️  Session Paused - Service Issue${NC}"
    echo -e "${YELLOW}════════════════════════════════════════════════════════════${NC}"
    echo ""
    echo -e "Claude's service appears to be temporarily unavailable."
    echo -e "This is usually resolved quickly."
    echo ""

    display_session_context

    echo -e "${CYAN}Suggestions:${NC}"
    echo -e "  • Check status.anthropic.com for service status"
    echo -e "  • Try again in a few minutes"
    echo ""

    display_resume_instructions
}

# Display generic interruption message (for unrecognized interruptions)
display_generic_interruption_exit() {
    echo ""
    echo -e "${YELLOW}════════════════════════════════════════════════════════════${NC}"
    echo -e "${YELLOW}⏸️  Session Interrupted${NC}"
    echo -e "${YELLOW}════════════════════════════════════════════════════════════${NC}"
    echo ""
    echo -e "The session ended without a recognized completion signal."
    echo -e "This may be due to a timeout, interruption, or unexpected issue."
    echo ""

    display_session_context
    display_resume_instructions
}

# Display iteration summary after story completion
display_iteration_summary() {
    local iteration="$1"
    local story_id="$2"
    local learned_before_file="$3"

    local active_prd=$(get_active_prd)
    local story_title=""
    local commit_msg=""
    local progress_info=""

    if [[ -n "$active_prd" ]]; then
        story_title=$(get_story_title "$active_prd" "$story_id")
    fi

    commit_msg=$(get_latest_commit_message)
    progress_info=$(get_total_progress)
    local complete=$(echo "$progress_info" | cut -d' ' -f1)
    local total=$(echo "$progress_info" | cut -d' ' -f2)

    echo ""
    echo -e "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}                    Iteration $iteration Complete                     ${NC}"
    echo -e "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
    echo ""
    echo -e "${GREEN}✓ USER STORY PASSED: $story_id${NC}"
    if [[ -n "$story_title" ]]; then
        echo -e "  ${BOLD}$story_title${NC}"
    fi
    echo ""

    # Display acceptance criteria
    if [[ -n "$active_prd" ]]; then
        local criteria=$(get_story_acceptance_criteria "$active_prd" "$story_id")
        if [[ -n "$criteria" ]]; then
            echo -e "${YELLOW}Acceptance Criteria Accomplished:${NC}"
            echo "$criteria" | while read -r criterion; do
                if [[ -n "$criterion" ]]; then
                    echo -e "  ${GREEN}✓${NC} $criterion"
                fi
            done
            echo ""
        fi
    fi

    # Display learned.md changes (if any)
    display_learned_changes "$learned_before_file"

    # Display commit message
    echo -e "${YELLOW}Git Commit:${NC}"
    echo -e "  $commit_msg"
    echo ""

    # Display progress
    echo -e "${YELLOW}Progress:${NC} $complete of $total stories complete"
    echo ""

    # Display fade status (story-level checkboxes for active PRD)
    if [[ -n "$active_prd" ]]; then
        echo -e "${YELLOW}Current PRD Status:${NC}"
        echo ""
        display_prd_stories "$active_prd"
        echo ""
    fi

    echo -e "${CYAN}───────────────────────────────────────────────────────────────${NC}"
    echo -e "${BLUE}Starting next iteration...${NC}"
    echo -e "${CYAN}───────────────────────────────────────────────────────────────${NC}"
    echo ""
}

# Build context from FADE files
# Checks fade/ directory first, falls back to root for backwards compatibility
build_context() {
    local context=""

    # FADE.md always at root
    if [[ -f "FADE.md" ]]; then
        context+="# PROJECT CONTEXT (FADE.md)

$(cat FADE.md)

---

"
    fi

    # progress.md: check fade/ first, then root
    if [[ -f "fade/progress.md" ]]; then
        context+="# SESSION HISTORY (progress.md)

$(cat fade/progress.md)

---

"
    elif [[ -f "progress.md" ]]; then
        context+="# SESSION HISTORY (progress.md)

$(cat progress.md)

---

"
    fi

    # learned.md: check fade/ first, then root
    if [[ -f "fade/learned.md" ]]; then
        context+="# LEARNED (learned.md)

$(cat fade/learned.md)

---

"
    elif [[ -f "learned.md" ]]; then
        context+="# LEARNED (learned.md)

$(cat learned.md)

---

"
    fi

    # prompt.md: check fade/ first, then root
    if [[ -f "fade/prompt.md" ]]; then
        context+="# EXECUTION INSTRUCTIONS (prompt.md)

$(cat fade/prompt.md)

---

"
    elif [[ -f "prompt.md" ]]; then
        context+="# EXECUTION INSTRUCTIONS (prompt.md)

$(cat prompt.md)

---

"
    fi

    context+="# START NOW

Read the context above, find the next incomplete story, and begin implementation.
After completing the story, output STORY_DONE, ALL_COMPLETE, or BLOCKED as appropriate.
"

    echo "$context"
}

# ============================================================================
# DISPLAY FUNCTIONS
# ============================================================================

display_work_queue() {
    local format="${1:-pretty}"  # pretty or json

    local priority_prd=""
    local priority_name=""
    local priority_type=""
    local priority_incomplete=0
    local priority_complete=0

    declare -a queue_prds
    declare -a queue_names
    declare -a queue_types
    declare -a queue_incomplete
    declare -a queue_complete

    # Check fade/prd.json first (new contained structure)
    if [[ -f "fade/prd.json" ]] && prd_has_incomplete_stories "fade/prd.json"; then
        priority_prd="fade/prd.json"
        priority_name=$(get_prd_name "fade/prd.json")
        priority_type=$(get_prd_type "fade/prd.json")
        priority_incomplete=$(count_incomplete_stories "fade/prd.json")
        priority_complete=$(count_complete_stories "fade/prd.json")
    # Fall back to root prd.json (legacy structure)
    elif [[ -f "prd.json" ]] && prd_has_incomplete_stories "prd.json"; then
        priority_prd="prd.json"
        priority_name=$(get_prd_name "prd.json")
        priority_type=$(get_prd_type "prd.json")
        priority_incomplete=$(count_incomplete_stories "prd.json")
        priority_complete=$(count_complete_stories "prd.json")
    fi

    # Check fade/prds/ first (new contained structure)
    if [[ -d "fade/prds" ]]; then
        for prd_file in $(ls fade/prds/*.json 2>/dev/null | sort); do
            [[ -f "$prd_file" ]] || continue
            if prd_has_incomplete_stories "$prd_file"; then
                queue_prds+=("$prd_file")
                queue_names+=("$(get_prd_name "$prd_file")")
                queue_types+=("$(get_prd_type "$prd_file")")
                queue_incomplete+=("$(count_incomplete_stories "$prd_file")")
                queue_complete+=("$(count_complete_stories "$prd_file")")
            fi
        done
    fi

    # Fall back to root prds/ (legacy structure)
    if [[ -d "prds" ]]; then
        for prd_file in $(ls prds/*.json 2>/dev/null | sort); do
            [[ -f "$prd_file" ]] || continue
            if prd_has_incomplete_stories "$prd_file"; then
                queue_prds+=("$prd_file")
                queue_names+=("$(get_prd_name "$prd_file")")
                queue_types+=("$(get_prd_type "$prd_file")")
                queue_incomplete+=("$(count_incomplete_stories "$prd_file")")
                queue_complete+=("$(count_complete_stories "$prd_file")")
            fi
        done
    fi
    
    local total_items=0
    [[ -n "$priority_prd" ]] && ((total_items++))
    ((total_items += ${#queue_prds[@]}))
    
    # JSON output
    if [[ "$format" == "json" ]]; then
        # Detect artifact paths and versions
        local fade_md_path=""
        local prompt_md_path=""
        local fade_md_version=""
        local prompt_md_version=""

        if [[ -f "FADE.md" ]]; then
            fade_md_path="FADE.md"
            fade_md_version=$(get_artifact_version "FADE.md")
        fi

        if [[ -f "fade/prompt.md" ]]; then
            prompt_md_path="fade/prompt.md"
            prompt_md_version=$(get_artifact_version "fade/prompt.md")
        elif [[ -f "prompt.md" ]]; then
            prompt_md_path="prompt.md"
            prompt_md_version=$(get_artifact_version "prompt.md")
        fi

        echo "{"
        echo "  \"version\": \"$FADE_VERSION\","
        echo "  \"artifacts\": {"
        if [[ -n "$fade_md_path" ]]; then
            echo "    \"fade_md\": {"
            echo "      \"path\": \"$fade_md_path\","
            if [[ -n "$fade_md_version" ]]; then
                echo "      \"version\": \"$fade_md_version\""
            else
                echo "      \"version\": null"
            fi
            echo "    },"
        else
            echo "    \"fade_md\": null,"
        fi
        if [[ -n "$prompt_md_path" ]]; then
            echo "    \"prompt_md\": {"
            echo "      \"path\": \"$prompt_md_path\","
            if [[ -n "$prompt_md_version" ]]; then
                echo "      \"version\": \"$prompt_md_version\""
            else
                echo "      \"version\": null"
            fi
            echo "    }"
        else
            echo "    \"prompt_md\": null"
        fi
        echo "  },"
        echo "  \"total_items\": $total_items,"

        if [[ -n "$priority_prd" ]]; then
            echo "  \"priority\": {"
            echo "    \"file\": \"$priority_prd\","
            echo "    \"name\": \"$priority_name\","
            echo "    \"type\": \"$priority_type\","
            echo "    \"incomplete\": $priority_incomplete,"
            echo "    \"complete\": $priority_complete"
            echo "  },"
        else
            echo "  \"priority\": null,"
        fi

        echo "  \"queue\": ["
        for i in "${!queue_prds[@]}"; do
            echo "    {"
            echo "      \"file\": \"${queue_prds[$i]}\","
            echo "      \"name\": \"${queue_names[$i]}\","
            echo "      \"type\": \"${queue_types[$i]}\","
            echo "      \"incomplete\": ${queue_incomplete[$i]},"
            echo "      \"complete\": ${queue_complete[$i]}"
            if [[ $i -eq $((${#queue_prds[@]} - 1)) ]]; then
                echo "    }"
            else
                echo "    },"
            fi
        done
        echo "  ]"
        echo "}"
        return 0
    fi
    
    # Pretty output
    echo ""
    echo -e "${CYAN}════════════════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}                     FADE Work Queue                         ${NC}"
    echo -e "${CYAN}════════════════════════════════════════════════════════════${NC}"
    echo ""
    
    if [[ $total_items -eq 0 ]]; then
        echo -e "${GREEN}✓ No incomplete work found!${NC}"
        echo ""
        echo "Create a PRD in prds/ or add prd.json to get started."
        return 1
    fi
    
    # Priority PRD
    if [[ -n "$priority_prd" ]]; then
        echo -e "${RED}⚡ PRIORITY${NC} ${BOLD}(prd.json)${NC}"
        echo -e "   ${YELLOW}[$priority_type]${NC} $priority_name"
        echo -e "   └─ ${GREEN}$priority_complete done${NC} / ${RED}$priority_incomplete remaining${NC}"
        echo ""
    fi
    
    # Queue PRDs
    if [[ ${#queue_prds[@]} -gt 0 ]]; then
        echo -e "${BLUE}📋 QUEUE${NC} ${BOLD}(prds/)${NC}"
        
        for i in "${!queue_prds[@]}"; do
            local filename=$(basename "${queue_prds[$i]}")
            echo -e "   ${YELLOW}[${queue_types[$i]}]${NC} $filename"
            echo -e "   │   ${queue_names[$i]}"
            echo -e "   └─ ${GREEN}${queue_complete[$i]} done${NC} / ${RED}${queue_incomplete[$i]} remaining${NC}"
            [[ $i -lt $((${#queue_prds[@]} - 1)) ]] && echo ""
        done
        echo ""
    fi
    
    echo -e "${CYAN}────────────────────────────────────────────────────────────${NC}"
    echo -e "Total: ${BOLD}$total_items${NC} PRD(s) with incomplete work"
    echo -e "${CYAN}────────────────────────────────────────────────────────────${NC}"
    echo ""
    
    return 0
}

# FIXED: Menu output goes to stderr, only result goes to stdout
ask_execution_mode() {
    echo -e "${YELLOW}How would you like to proceed?${NC}" >&2
    echo "" >&2
    echo -e "  ${GREEN}STOP${NC}  - Complete one story, then pause for review" >&2
    echo -e "  ${BLUE}ALL${NC}   - Process all stories automatically (fresh context each story)" >&2
    echo "" >&2
    
    while true; do
        read -p "Enter mode [STOP/ALL]: " mode </dev/tty
        mode=$(echo "$mode" | tr '[:lower:]' '[:upper:]')
        
        case "$mode" in
            STOP|S)
                echo "STOP"
                return
                ;;
            ALL|A)
                echo "ALL"
                return
                ;;
            *)
                echo -e "${RED}Invalid choice. Enter STOP or ALL.${NC}" >&2
                ;;
        esac
    done
}

# ============================================================================
# EXIT SIGNALS (Reference)
# ============================================================================
# Valid exit signals for FADE session control. Claude outputs these signals
# and this script detects them to control loop behavior.
#
# Source of truth: prompt.md (Exit Signals section defines Claude's behavior)
#
# Signal          Format                  Meaning
# --------------- ----------------------- -------------------------------------
# STORY_DONE      STORY_DONE: US-XXX      One story completed, more work remains
# ALL_COMPLETE    ALL_COMPLETE            All stories in queue finished
# BLOCKED         BLOCKED: [reason]       Cannot proceed, human intervention needed
#
# Detection: Simple string matching via grep (see cmd_run ALL mode loop)
#
# INTERRUPTIONS
# -------------
# The loop also detects known interruption patterns that aren't errors.
# Detection is done via detect_interruption() function.
#
# Type            Patterns                              Exit Code
# --------------- ------------------------------------- ---------
# rate_limit      "You've hit your limit"               2
# network_error   "connection refused", "unreachable"   3
# service_error   "service unavailable", "503", "502"   3
#
# Exit codes:
#   0 = success (ALL_COMPLETE)
#   1 = error/blocked (BLOCKED or unknown error)
#   2 = rate limited (session limit reached)
#   3 = transient error (network/service issues, retry later)
# ============================================================================

# ============================================================================
# COMMANDS
# ============================================================================

cmd_init() {
    echo -e "${CYAN}Initializing FADE structure...${NC}"
    echo ""

    local created=0

    # FADE.md stays at project root (visible, human-curated)
    create_file_if_missing "FADE.md" "$FADE_TEMPLATE" && ((created++)) || true

    # CLAUDE.md redirect at project root (for Claude Code discovery)
    create_file_if_missing "CLAUDE.md" "$CLAUDE_TEMPLATE" && ((created++)) || true

    # Create fade/ directory for other FADE files
    if [[ ! -d "fade" ]]; then
        mkdir -p "fade"
        echo -e "  ${GREEN}create${NC}: fade/"
        ((created++))
    else
        echo -e "  ${YELLOW}skip${NC}: fade/ (already exists)"
    fi

    # Other FADE files go inside fade/
    create_file_if_missing "fade/progress.md" "$PROGRESS_TEMPLATE" && ((created++)) || true
    create_file_if_missing "fade/learned.md" "$LEARNED_TEMPLATE" && ((created++)) || true
    create_file_if_missing "fade/prompt.md" "$PROMPT_TEMPLATE" && ((created++)) || true

    # Create fade/prds/ folder
    if [[ ! -d "fade/prds" ]]; then
        mkdir -p "fade/prds"
        cat > "fade/prds/README.md" << 'PRDS_EOF'
# PRDs Folder

Place your PRD files here using the naming convention:

```
{TYPE}-{NUMBER}-{slug}.json
```

## Examples

- `FEAT-001-user-authentication.json`
- `BUG-002-login-timeout.json`
- `CHORE-003-upgrade-dependencies.json`
- `ENH-004-improve-performance.json`
- `SPIKE-005-evaluate-caching.json`

## Selection Order

FADE picks the lowest-numbered PRD with incomplete stories.
Priority: fade/prd.json (if exists) → fade/prds/ folder (by number)
PRDS_EOF
        echo -e "  ${GREEN}create${NC}: fade/prds/"
        ((created++))
    else
        echo -e "  ${YELLOW}skip${NC}: fade/prds/ (already exists)"
    fi

    # Create fade/prd-archive/ folder
    if [[ ! -d "fade/prd-archive" ]]; then
        mkdir -p "fade/prd-archive"
        touch "fade/prd-archive/.gitkeep"
        echo -e "  ${GREEN}create${NC}: fade/prd-archive/"
        ((created++))
    else
        echo -e "  ${YELLOW}skip${NC}: fade/prd-archive/ (already exists)"
    fi

    echo ""
    if [[ $created -eq 0 ]]; then
        echo "No files created. FADE structure already exists."
    else
        echo -e "${GREEN}Created $created file(s).${NC}"
    fi

    echo ""
    echo "Next steps:"
    echo "  1. Edit FADE.md with your project context"
    echo "  2. Create a PRD in fade/prds/ folder"
    echo "  3. Run 'fade run' to start working"
}

cmd_run() {
    local yolo_mode=false
    local quiet_mode=false

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --yolo)
                yolo_mode=true
                shift
                ;;
            --quiet|-q)
                quiet_mode=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    if [[ "$yolo_mode" == true ]]; then
        echo -e "${CYAN}FADE v$FADE_VERSION${NC} ${YELLOW}🤘 YOLO MODE${NC}"
    else
        echo -e "${CYAN}FADE v$FADE_VERSION${NC}"
    fi
    echo ""

    # Check for FADE files
    if [[ ! -f "FADE.md" ]]; then
        echo -e "${RED}Error: FADE.md not found. Run 'fade init' first.${NC}"
        exit 1
    fi

    # Display work queue
    if ! display_work_queue; then
        exit 0
    fi

    # Determine execution mode
    local mode
    if [[ "$yolo_mode" == true ]]; then
        mode="ALL"
        echo -e "${YELLOW}🤘 YOLO MODE - Skipping prompts, going straight to ALL mode${NC}"
    else
        mode=$(ask_execution_mode)
    fi

    echo ""
    echo -e "${GREEN}Starting in $mode mode...${NC}"
    echo ""

    # Set Claude command based on yolo mode
    local claude_cmd="claude"
    if [[ "$yolo_mode" == true ]]; then
        claude_cmd="claude --dangerously-skip-permissions"
    fi

    if [[ "$mode" == "STOP" ]]; then
        # STOP mode: single execution, hand over terminal completely
        local context=$(build_context)
        exec $claude_cmd "$context"
    else
        # ALL mode: loop until complete or blocked
        local iteration=1

        while true; do
            echo -e "${CYAN}────────────────────────────────────────────────────────────${NC}"
            echo -e "${CYAN}Iteration $iteration - Building fresh context...${NC}"
            echo -e "${CYAN}────────────────────────────────────────────────────────────${NC}"
            echo ""

            # Capture learned.md content before iteration (for change detection)
            # Check fade/ first, fall back to root for backwards compatibility
            local learned_before_file=$(mktemp)
            if [[ -f "fade/learned.md" ]]; then
                cp fade/learned.md "$learned_before_file"
            elif [[ -f "learned.md" ]]; then
                cp learned.md "$learned_before_file"
            else
                touch "$learned_before_file"
            fi

            local context=$(build_context)

            # Run Claude and capture output
            local output_file=$(mktemp)

            # Run claude interactively but capture output
            $claude_cmd "$context" 2>&1 | tee "$output_file"
            local exit_code=${PIPESTATUS[0]}

            local output=$(cat "$output_file")
            rm -f "$output_file"

            # Check for signals in output
            if echo "$output" | grep -qx "ALL_COMPLETE"; then
                rm -f "$learned_before_file"
                echo ""
                echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
                echo -e "${GREEN}🎉 ALL WORK COMPLETE!${NC}"
                echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
                echo ""

                # Archive completed PRDs
                echo -e "${YELLOW}Archiving completed PRDs...${NC}"

                # Archive prd.json if it exists and is complete
                local priority_output=$(archive_priority_prd)
                local priority_archived=$(echo "$priority_output" | tail -1)
                # Display archive message (all but last line which is the count)
                echo "$priority_output" | sed '$d'

                # Archive completed PRDs from prds/ folder
                local archived_output=$(archive_completed_prds)
                local archived_count=$(echo "$archived_output" | tail -1)
                # Display archive messages (all but last line which is the count)
                echo "$archived_output" | sed '$d'

                # Calculate total archived
                local total_archived=$((${priority_archived:-0} + ${archived_count:-0}))

                if [[ "$total_archived" -gt 0 ]]; then
                    echo -e "${GREEN}Archived $total_archived PRD(s) to prd-archive/${NC}"
                else
                    echo -e "  ${CYAN}No completed PRDs to archive${NC}"
                fi
                echo ""
                break
            fi

            if echo "$output" | grep -q "BLOCKED"; then
                rm -f "$learned_before_file"
                echo ""
                echo -e "${RED}════════════════════════════════════════════════════════════${NC}"
                echo -e "${RED}⛔ BLOCKED - Human intervention required${NC}"
                echo -e "${RED}════════════════════════════════════════════════════════════${NC}"
                break
            fi

            if echo "$output" | grep -q "STORY_DONE"; then
                # Extract story ID from STORY_DONE signal (format: STORY_DONE: US-XXX)
                local story_id=$(echo "$output" | grep -o 'STORY_DONE:[[:space:]]*[A-Z]*-[0-9]*' | head -1 | sed 's/STORY_DONE:[[:space:]]*//')

                # Display iteration summary (unless --quiet flag is set)
                if [[ "$quiet_mode" != true ]]; then
                    display_iteration_summary "$iteration" "$story_id" "$learned_before_file"
                fi

                rm -f "$learned_before_file"
                ((iteration++))
                sleep 2  # Brief pause for filesystem to settle
                continue
            fi

            # Check for known interruption patterns (before treating as unknown)
            local interruption_type=$(detect_interruption "$output")

            if [[ -n "$interruption_type" ]]; then
                rm -f "$learned_before_file"
                case "$interruption_type" in
                    rate_limit)
                        display_rate_limit_exit "$output"
                        exit 2  # Exit code 2 = rate limited
                        ;;
                    network_error)
                        display_network_error_exit
                        exit 3  # Exit code 3 = network error
                        ;;
                    service_error)
                        display_service_error_exit
                        exit 3  # Exit code 3 = service error
                        ;;
                esac
            fi

            # No recognized signal or interruption - show generic message
            rm -f "$learned_before_file"
            display_generic_interruption_exit
            break

        done
    fi
}

cmd_yolo() {
    # Convenience command: fade yolo is equivalent to fade run --yolo
    # Pass through any additional arguments (e.g., --quiet)
    cmd_run "--yolo" "$@"
}

cmd_new() {
    local prd_type="${1:-}"
    local prd_name="${2:-}"

    # Validate type
    if [[ -z "$prd_type" ]]; then
        echo -e "${RED}Error: PRD type required.${NC}"
        echo ""
        echo "Usage: fade new <type> \"<name>\""
        echo ""
        echo "Types: feature, bug, toil, enhancement, spike"
        echo ""
        echo "Examples:"
        echo "  fade new feature \"User authentication\""
        echo "  fade new bug \"Login timeout issue\""
        echo "  fade new spike \"Evaluate caching strategies\""
        exit 1
    fi

    # Normalize type to lowercase
    local type_lower=$(echo "$prd_type" | tr '[:upper:]' '[:lower:]')

    # Map type to standard prefix
    local type_prefix=""
    local type_full=""
    case "$type_lower" in
        feature|feat)
            type_prefix="FEAT"
            type_full="feature"
            ;;
        bug)
            type_prefix="BUG"
            type_full="bug"
            ;;
        toil|chore)
            type_prefix="CHORE"
            type_full="chore"
            ;;
        enhancement|enh)
            type_prefix="ENH"
            type_full="enhancement"
            ;;
        spike)
            type_prefix="SPIKE"
            type_full="spike"
            ;;
        *)
            echo -e "${RED}Error: Unknown PRD type '$prd_type'${NC}"
            echo ""
            echo "Valid types: feature, bug, toil, enhancement, spike"
            exit 1
            ;;
    esac

    # Validate name
    if [[ -z "$prd_name" ]]; then
        echo -e "${RED}Error: PRD name required.${NC}"
        echo ""
        echo "Usage: fade new $prd_type \"<name>\""
        echo ""
        echo "Example: fade new $prd_type \"My awesome PRD\""
        exit 1
    fi

    # Determine PRD folder location
    # Prefer fade/prds/ if fade/ exists, fall back to prds/ at root
    local prds_dir=""
    if [[ -d "fade/prds" ]]; then
        prds_dir="fade/prds"
    elif [[ -d "fade" ]]; then
        # fade/ exists but prds/ doesn't - create it
        mkdir -p "fade/prds"
        prds_dir="fade/prds"
    elif [[ -d "prds" ]]; then
        # Legacy structure - prds/ at root
        prds_dir="prds"
    else
        echo -e "${RED}Error: No PRD folder found.${NC}"
        echo ""
        echo "Run 'fade init' first to create the FADE structure."
        exit 1
    fi

    # Generate slug from name
    local slug=$(generate_slug "$prd_name")

    # Find next available number for this type
    local next_num=1
    for existing_file in "$prds_dir"/${type_prefix}-*.json; do
        [[ -f "$existing_file" ]] || continue
        local filename=$(basename "$existing_file" .json)
        # Extract number from filename (TYPE-NNN-slug)
        local num=$(echo "$filename" | sed -n "s/^${type_prefix}-\([0-9]*\)-.*/\1/p")
        if [[ -n "$num" ]]; then
            # Remove leading zeros for comparison
            num=$((10#$num))
            if [[ $num -ge $next_num ]]; then
                next_num=$((num + 1))
            fi
        fi
    done

    # Format number with leading zeros (3 digits)
    local num_formatted=$(printf "%03d" "$next_num")

    # Build filename
    local prd_filename="${type_prefix}-${num_formatted}-${slug}.json"
    local prd_path="$prds_dir/$prd_filename"

    # Check if file already exists (shouldn't happen but just in case)
    if [[ -f "$prd_path" ]]; then
        echo -e "${RED}Error: PRD file already exists: $prd_path${NC}"
        exit 1
    fi

    # Generate PRD ID
    local prd_id="${type_prefix}-${num_formatted}"

    # Create PRD JSON content
    local prd_content=""
    if [[ "$type_full" == "spike" ]]; then
        # Spike PRD has additional fields
        local branch_name="spike/${slug}"
        prd_content=$(cat << PRDEOF
{
  "type": "$type_full",
  "project": "$(basename "$(pwd)")",
  "id": "$prd_id",
  "name": "$prd_name",
  "description": "",
  "branchName": "$branch_name",
  "outputArtifact": "docs/spike-${slug}.md",
  "dependsOn": [],
  "userStories": [
    {
      "id": "US-001",
      "title": "Investigation and documentation",
      "description": "Research and document findings",
      "acceptanceCriteria": [
        "Research completed",
        "Findings documented in output artifact",
        "Recommendations provided"
      ],
      "priority": 1,
      "passes": false
    }
  ]
}
PRDEOF
)
    else
        # Standard PRD
        prd_content=$(cat << PRDEOF
{
  "type": "$type_full",
  "project": "$(basename "$(pwd)")",
  "id": "$prd_id",
  "name": "$prd_name",
  "description": "",
  "dependsOn": [],
  "userStories": [
    {
      "id": "US-001",
      "title": "",
      "description": "",
      "acceptanceCriteria": [
        ""
      ],
      "priority": 1,
      "passes": false
    }
  ]
}
PRDEOF
)
    fi

    # Write PRD file
    echo "$prd_content" > "$prd_path"

    echo -e "${GREEN}Created PRD:${NC} $prd_path"
    echo ""
    echo -e "${BOLD}$prd_name${NC}"
    echo -e "  Type: ${YELLOW}[$type_prefix]${NC} $type_full"
    echo -e "  ID:   $prd_id"
    echo ""

    # For spikes, create the feature branch
    if [[ "$type_full" == "spike" ]]; then
        local branch_name="spike/${slug}"
        echo -e "${YELLOW}Creating spike branch...${NC}"

        # Check if we're in a git repo
        if ! git rev-parse --git-dir &>/dev/null; then
            echo -e "${YELLOW}Warning: Not in a git repository. Skipping branch creation.${NC}"
        else
            # Check if branch already exists
            if git show-ref --quiet "refs/heads/$branch_name"; then
                echo -e "${YELLOW}Branch '$branch_name' already exists. Switching to it...${NC}"
                git checkout "$branch_name"
            else
                git checkout -b "$branch_name"
                echo -e "${GREEN}Created and switched to branch:${NC} $branch_name"
            fi
        fi
        echo ""
    fi

    echo "Next steps:"
    echo "  1. Edit $prd_path to add description and user stories"
    echo "  2. Run 'fade run' to start working"
}

cmd_status() {
    local format="pretty"
    
    # Check for --json flag
    if [[ "${1:-}" == "--json" ]]; then
        format="json"
    fi
    
    if [[ "$format" == "pretty" ]]; then
        echo -e "${CYAN}FADE v$FADE_VERSION${NC}"
    fi
    
    display_work_queue "$format"
}

cmd_version() {
    local show_all=false

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all|-a)
                show_all=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    if [[ "$show_all" == "false" ]]; then
        echo "v$FADE_VERSION"
        return
    fi

    # --all flag: show CLI version plus all artifact versions
    echo -e "${CYAN}FADE Version Information${NC}"
    echo ""
    echo -e "  CLI:         ${GREEN}v$FADE_VERSION${NC}"
    echo ""

    # Define artifacts to check (filename, display name, paths to check)
    local -a artifacts=("FADE.md" "prompt.md" "CLAUDE.md" "progress.md" "learned.md")
    local has_warnings=false

    echo -e "  ${BOLD}Artifacts:${NC}"

    for artifact in "${artifacts[@]}"; do
        local path=""
        local version=""
        local display_name="$artifact"

        # Check both contained (fade/) and legacy (root) locations
        if [[ "$artifact" == "FADE.md" ]]; then
            # FADE.md stays at root in both structures
            if [[ -f "FADE.md" ]]; then
                path="FADE.md"
            fi
        else
            # Other artifacts: check fade/ first, then root
            if [[ -f "fade/$artifact" ]]; then
                path="fade/$artifact"
            elif [[ -f "$artifact" ]]; then
                path="$artifact"
            fi
        fi

        if [[ -z "$path" ]]; then
            echo -e "    $display_name:       ${YELLOW}not found${NC}"
            continue
        fi

        version=$(get_artifact_version "$path")

        if [[ -z "$version" ]]; then
            echo -e "    $display_name:       ${YELLOW}no version${NC}"
            has_warnings=true
        elif [[ "$version" != "$FADE_VERSION" ]]; then
            echo -e "    $display_name:       ${YELLOW}v$version (outdated)${NC}"
            has_warnings=true
        else
            echo -e "    $display_name:       ${GREEN}v$version${NC}"
        fi
    done

    echo ""
    if [[ "$has_warnings" == "true" ]]; then
        echo -e "  ${YELLOW}Note: Some artifacts have version mismatches. Run 'fade update' to sync.${NC}"
    else
        echo -e "  ${GREEN}All artifacts match CLI version.${NC}"
    fi
}

cmd_help() {
    cat << EOF
${CYAN}FADE v$FADE_VERSION${NC} - Framework for Agentic Development and Engineering

${YELLOW}Usage:${NC} fade <command> [options]

${YELLOW}Commands:${NC}
  init          Create FADE structure (FADE.md, progress.md, learned.md, prds/)
  new           Create a new PRD file (fade new <type> "<name>")
  run           Show work queue, choose STOP/ALL mode, start Claude Code
  run --yolo    Skip prompts, go straight to ALL mode with --dangerously-skip-permissions
  yolo          🤘 Shortcut for 'fade run --yolo' - skip permission prompts
  status        Show current work queue
  migrate       Move legacy FADE files into contained fade/ structure
  update        Update FADE CLI and prompt.md to latest versions from GitHub
  version       Show FADE version
  help          Show this help message

${YELLOW}New Command:${NC}
  fade new <type> "<name>"

  Types: feature, bug, toil, enhancement, spike

  Creates a new PRD file with the naming convention: {TYPE}-{NNN}-{slug}.json
  - Uses fade/prds/ for contained structure
  - Falls back to prds/ for legacy structure
  - For spikes, also creates and switches to a feature branch

${YELLOW}Run Options:${NC}
  --yolo        Skip prompts, use ALL mode with --dangerously-skip-permissions
  --quiet, -q   Suppress iteration summaries in ALL/YOLO mode (final message still shown)

${YELLOW}Migrate Options:${NC}
  --dry-run     Show what would be moved without making changes
  --yes, -y     Skip confirmation prompt

${YELLOW}Update Options:${NC}
  --check       Check for updates without applying (exit code: 0=up-to-date, 1=updates available)
  --cli-only    Only update the CLI, skip prompt.md template update

${YELLOW}Status Options:${NC}
  --json        Output status as JSON (for scripting)

${YELLOW}Version Options:${NC}
  --all, -a     Show CLI version plus all detected artifact versions

${YELLOW}Execution Modes:${NC}
  STOP          Complete one story, then pause for human review
  ALL           Process all stories with fresh context between each
                (Note: ALL mode may have issues with Claude's interactive terminal)

${YELLOW}PRD Locations:${NC}
  Contained (new):   fade/prd.json, fade/prds/
  Legacy:            prd.json, prds/
  (Script checks fade/ first, falls back to root for backwards compatibility)

${YELLOW}PRD Naming Convention:${NC}
  {TYPE}-{NUMBER}-{slug}.json

  Types: FEAT, BUG, CHORE, ENH, SPIKE

${YELLOW}Git Commit Prefixes:${NC}
  feat:         New feature
  fix:          Bug fix
  docs:         Documentation
  chore:        Maintenance, dependencies
  refactor:     Code restructure
  spike:        Exploratory work

${YELLOW}Examples:${NC}
  fade init                              # Set up FADE in current directory
  fade new feature "User authentication" # Create a new feature PRD
  fade new bug "Login timeout"           # Create a new bug PRD
  fade new spike "Evaluate caching"      # Create spike PRD and branch
  fade run                               # See queue, pick mode, start working
  fade yolo                              # 🤘 Full auto mode, no prompts
  fade yolo --quiet                      # 🤘 Full auto mode, minimal output
  fade run --yolo --quiet                # Same as above
  fade status                            # Check work queue
  fade status --json                     # Machine-readable status
  fade migrate                           # Move legacy files to fade/ structure
  fade migrate --dry-run                 # Preview migration without changes
  fade update                            # Update CLI and prompt.md
  fade update --check                    # Check for updates without applying
  fade update --cli-only                 # Update CLI only, keep local prompt.md
  fade version                           # Show CLI version
  fade version --all                     # Show CLI and all artifact versions

EOF
}

# ============================================================================
# MIGRATE COMMAND
# ============================================================================

cmd_migrate() {
    local dry_run=false
    local skip_confirm=false

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)
                dry_run=true
                shift
                ;;
            --yes|-y)
                skip_confirm=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    echo -e "${CYAN}FADE Migration${NC}"
    echo ""

    if [[ "$dry_run" == true ]]; then
        echo -e "${YELLOW}DRY RUN - No files will be modified${NC}"
        echo ""
    fi

    # Check if already using contained structure
    if [[ -d "fade" ]]; then
        echo -e "${YELLOW}Note: fade/ directory already exists${NC}"
        echo ""
    fi

    # Detect legacy FADE files at project root
    local found_files=()
    local found_dirs=()

    # Check for FADE.md (should stay at root)
    if [[ -f "FADE.md" ]]; then
        echo -e "${GREEN}✓${NC} FADE.md found at root (will stay in place)"
    else
        echo -e "${YELLOW}⚠${NC} FADE.md not found - is this a FADE project?"
        echo ""
        echo "Run 'fade init' to create a new FADE structure."
        exit 1
    fi

    # Check for files to migrate
    if [[ -f "progress.md" ]]; then
        found_files+=("progress.md")
        echo -e "${BLUE}→${NC} progress.md found (will move to fade/)"
    fi

    if [[ -f "learned.md" ]]; then
        found_files+=("learned.md")
        echo -e "${BLUE}→${NC} learned.md found (will move to fade/)"
    fi

    if [[ -f "prompt.md" ]]; then
        found_files+=("prompt.md")
        echo -e "${BLUE}→${NC} prompt.md found (will move to fade/)"
    fi

    if [[ -f "prd.json" ]]; then
        found_files+=("prd.json")
        echo -e "${BLUE}→${NC} prd.json found (will move to fade/)"
    fi

    # Check for directories to migrate
    if [[ -d "prds" ]]; then
        found_dirs+=("prds")
        echo -e "${BLUE}→${NC} prds/ found (will move to fade/prds/)"
    fi

    if [[ -d "prd-archive" ]]; then
        found_dirs+=("prd-archive")
        echo -e "${BLUE}→${NC} prd-archive/ found (will move to fade/prd-archive/)"
    fi

    # Check for CLAUDE.md
    local need_claude_md=false
    if [[ ! -f "CLAUDE.md" ]]; then
        need_claude_md=true
        echo -e "${BLUE}+${NC} CLAUDE.md will be created"
    else
        echo -e "${GREEN}✓${NC} CLAUDE.md already exists"
    fi

    echo ""

    # Check if there's anything to migrate
    if [[ ${#found_files[@]} -eq 0 && ${#found_dirs[@]} -eq 0 && "$need_claude_md" == false ]]; then
        echo -e "${GREEN}✓ Nothing to migrate - project may already be using contained structure${NC}"
        return 0
    fi

    # Summary
    local total_items=$((${#found_files[@]} + ${#found_dirs[@]}))
    if [[ "$need_claude_md" == true ]]; then
        ((total_items++))
    fi

    echo -e "${BOLD}Migration Summary:${NC}"
    echo -e "  Files to move:    ${#found_files[@]}"
    echo -e "  Folders to move:  ${#found_dirs[@]}"
    if [[ "$need_claude_md" == true ]]; then
        echo -e "  Files to create:  1 (CLAUDE.md)"
    fi
    echo ""

    # If dry run, stop here
    if [[ "$dry_run" == true ]]; then
        echo -e "${CYAN}════════════════════════════════════════════════════════════${NC}"
        echo -e "${CYAN}DRY RUN COMPLETE - Run without --dry-run to apply changes${NC}"
        echo -e "${CYAN}════════════════════════════════════════════════════════════${NC}"
        return 0
    fi

    # Confirm before proceeding
    if [[ "$skip_confirm" != true ]]; then
        echo -e "${YELLOW}This will move files to a new contained structure.${NC}"
        read -p "Proceed with migration? [y/N]: " confirm </dev/tty

        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo -e "${CYAN}Migration cancelled.${NC}"
            return 0
        fi
    fi

    echo ""
    echo -e "${CYAN}Migrating...${NC}"
    echo ""

    local moved_count=0
    local created_count=0

    # Create fade/ directory if it doesn't exist
    if [[ ! -d "fade" ]]; then
        mkdir -p "fade"
        echo -e "  ${GREEN}create${NC}: fade/"
        ((created_count++))
    fi

    # Move files to fade/
    for file in "${found_files[@]}"; do
        if [[ -f "$file" ]]; then
            # Check if destination already exists
            if [[ -f "fade/$file" ]]; then
                echo -e "  ${YELLOW}skip${NC}: $file (fade/$file already exists)"
            else
                mv "$file" "fade/$file"
                echo -e "  ${GREEN}move${NC}: $file → fade/$file"
                ((moved_count++))
            fi
        fi
    done

    # Move directories to fade/
    for dir in "${found_dirs[@]}"; do
        if [[ -d "$dir" ]]; then
            # Check if destination already exists
            if [[ -d "fade/$dir" ]]; then
                echo -e "  ${YELLOW}skip${NC}: $dir/ (fade/$dir/ already exists)"
                echo -e "        You may need to manually merge the contents"
            else
                mv "$dir" "fade/$dir"
                echo -e "  ${GREEN}move${NC}: $dir/ → fade/$dir/"
                ((moved_count++))
            fi
        fi
    done

    # Create CLAUDE.md redirect
    if [[ "$need_claude_md" == true ]]; then
        echo "$CLAUDE_TEMPLATE" > "CLAUDE.md"
        echo -e "  ${GREEN}create${NC}: CLAUDE.md"
        ((created_count++))
    fi

    echo ""

    # Report results
    echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}✓ Migration complete!${NC}"
    echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
    echo ""
    echo -e "  Moved:   $moved_count item(s)"
    echo -e "  Created: $created_count item(s)"
    echo ""
    echo -e "${BOLD}New structure:${NC}"
    echo "  ./FADE.md           # Project context (unchanged)"
    echo "  ./CLAUDE.md         # Redirect for Claude Code"
    echo "  ./fade/"
    if [[ -f "fade/prompt.md" ]]; then
        echo "    ├── prompt.md     # Execution instructions"
    fi
    if [[ -f "fade/progress.md" ]]; then
        echo "    ├── progress.md   # Session history"
    fi
    if [[ -f "fade/learned.md" ]]; then
        echo "    ├── learned.md    # Cumulative discoveries"
    fi
    if [[ -f "fade/prd.json" ]]; then
        echo "    ├── prd.json      # Priority PRD"
    fi
    if [[ -d "fade/prds" ]]; then
        echo "    ├── prds/         # PRD queue"
    fi
    if [[ -d "fade/prd-archive" ]]; then
        echo "    └── prd-archive/  # Completed PRDs"
    fi
    echo ""
}

# ============================================================================
# UPDATE COMMAND
# ============================================================================

FADE_UPDATE_URL="https://raw.githubusercontent.com/themitchelli/fade/main/fade"
FADE_VERSION_URL="https://raw.githubusercontent.com/themitchelli/fade/main/VERSION"
FADE_PROMPT_URL="https://raw.githubusercontent.com/themitchelli/fade/main/prompt.md"
FADE_MANIFEST_URL="https://raw.githubusercontent.com/themitchelli/fade/main/version-manifest.json"

# Fetch content from URL using curl or wget
fetch_url() {
    local url="$1"

    if command -v curl &>/dev/null; then
        curl -fsSL "$url" 2>/dev/null
    elif command -v wget &>/dev/null; then
        wget -qO- "$url" 2>/dev/null
    else
        return 1
    fi
}

# Check if URL is reachable
check_url() {
    local url="$1"

    if command -v curl &>/dev/null; then
        curl -fsSL --head "$url" &>/dev/null
        return $?
    elif command -v wget &>/dev/null; then
        wget -q --spider "$url" &>/dev/null
        return $?
    else
        return 1
    fi
}

# Get the path of the currently running fade script
get_fade_path() {
    # Try to resolve the actual path of this script
    local script_path="${BASH_SOURCE[0]}"

    # Follow symlinks to get the real path
    while [[ -L "$script_path" ]]; do
        local dir=$(dirname "$script_path")
        script_path=$(readlink "$script_path")
        [[ "$script_path" != /* ]] && script_path="$dir/$script_path"
    done

    # Get absolute path
    cd "$(dirname "$script_path")" && pwd -P
    echo "/$(basename "$script_path")"
}

cmd_update() {
    local cli_only=false
    local check_only=false

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --cli-only)
                cli_only=true
                shift
                ;;
            --check)
                check_only=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    echo -e "${CYAN}FADE Update${NC}"
    echo ""

    # Check for curl or wget
    if ! command -v curl &>/dev/null && ! command -v wget &>/dev/null; then
        echo -e "${RED}Error: Neither curl nor wget found. Please install one of them.${NC}"
        exit 1
    fi

    # Get current version
    local current_version="$FADE_VERSION"
    echo -e "Current version: ${BOLD}v$current_version${NC}"

    # Fetch latest version
    echo -e "Checking for updates..."
    echo ""

    local latest_version
    latest_version=$(fetch_url "$FADE_VERSION_URL") || true

    if [[ -z "$latest_version" ]]; then
        echo -e "${RED}Error: Could not fetch version information from GitHub.${NC}"
        echo "Please check your internet connection and try again."
        echo ""
        echo "URL: $FADE_VERSION_URL"
        exit 1
    fi

    # Clean up version string (remove leading 'v' if present, trim whitespace)
    latest_version=$(echo "$latest_version" | tr -d '[:space:]' | sed 's/^v//')

    echo -e "Latest version:  ${BOLD}v$latest_version${NC}"
    echo ""

    # ========================================================================
    # CHECK-ONLY MODE
    # ========================================================================

    if [[ "$check_only" == true ]]; then
        local has_updates=false
        local updates_available=()

        # Check CLI version
        if [[ "$current_version" != "$latest_version" ]]; then
            has_updates=true
            updates_available+=("CLI: v$current_version → v$latest_version")
        fi

        # Check artifact versions (FADE.md and prompt.md)
        # Prefer fade/ if exists, fall back to root
        local check_prompt_path=""
        local check_fade_md_path=""

        if [[ -f "fade/prompt.md" ]]; then
            check_prompt_path="fade/prompt.md"
        elif [[ -f "prompt.md" ]]; then
            check_prompt_path="prompt.md"
        fi

        if [[ -f "FADE.md" ]]; then
            check_fade_md_path="FADE.md"
        fi

        # Check FADE.md version
        if [[ -n "$check_fade_md_path" ]]; then
            local fade_md_version
            fade_md_version=$(get_artifact_version "$check_fade_md_path")
            if [[ -z "$fade_md_version" ]]; then
                updates_available+=("FADE.md: no version stamp (run fade update)")
                has_updates=true
            elif [[ "$fade_md_version" != "$latest_version" ]]; then
                updates_available+=("FADE.md: v$fade_md_version → v$latest_version")
                has_updates=true
            fi
        fi

        # Check prompt.md version and content (unless --cli-only)
        if [[ "$cli_only" != true ]] && [[ -n "$check_prompt_path" ]]; then
            local prompt_md_version
            prompt_md_version=$(get_artifact_version "$check_prompt_path")

            if [[ -z "$prompt_md_version" ]]; then
                updates_available+=("$check_prompt_path: no version stamp (run fade update)")
                has_updates=true
            elif [[ "$prompt_md_version" != "$latest_version" ]]; then
                updates_available+=("$check_prompt_path: v$prompt_md_version → v$latest_version")
                has_updates=true
            fi

            # Also check content diff for prompt.md
            local latest_prompt
            latest_prompt=$(fetch_url "$FADE_PROMPT_URL")

            if [[ $? -eq 0 ]] && [[ -n "$latest_prompt" ]]; then
                local current_prompt
                current_prompt=$(cat "$check_prompt_path")

                if [[ "$current_prompt" != "$latest_prompt" ]]; then
                    # Only add content diff message if we haven't already flagged version mismatch
                    if [[ "$prompt_md_version" == "$latest_version" ]]; then
                        has_updates=true
                        updates_available+=("$check_prompt_path: content differs from template")
                    fi
                fi
            fi
        fi

        # Report results
        if [[ "$has_updates" == true ]]; then
            echo -e "${YELLOW}Updates available:${NC}"
            for item in "${updates_available[@]}"; do
                echo -e "  • $item"
            done
            echo ""
            echo "Run 'fade update' to apply updates."
            exit 1
        else
            echo -e "${GREEN}✓ Everything is up to date!${NC}"
            exit 0
        fi
    fi

    local cli_updated=false
    local prompt_updated=false

    # ========================================================================
    # CLI UPDATE
    # ========================================================================

    # Compare versions
    if [[ "$current_version" == "$latest_version" ]]; then
        echo -e "${GREEN}✓ CLI already at latest version${NC}"
    else
        echo -e "${YELLOW}CLI update available.${NC}"
        echo ""

        # Get the path of the fade script to update
        local fade_script="${BASH_SOURCE[0]}"

        # Resolve to absolute path
        if [[ "$fade_script" != /* ]]; then
            fade_script="$(cd "$(dirname "$fade_script")" && pwd)/$(basename "$fade_script")"
        fi

        # Check if we have write permission
        if [[ ! -w "$fade_script" ]]; then
            echo -e "${RED}Error: Cannot write to $fade_script${NC}"
            echo "You may need to run with sudo or check file permissions."
            exit 1
        fi

        echo "Downloading CLI update..."

        # Fetch the new script
        local new_script
        new_script=$(fetch_url "$FADE_UPDATE_URL")

        if [[ $? -ne 0 ]] || [[ -z "$new_script" ]]; then
            echo -e "${RED}Error: Could not download the update from GitHub.${NC}"
            echo "Please check your internet connection and try again."
            echo ""
            echo "URL: $FADE_UPDATE_URL"
            exit 1
        fi

        # Verify the downloaded content looks like a valid fade script
        if ! echo "$new_script" | grep -q "^#!/bin/bash"; then
            echo -e "${RED}Error: Downloaded file does not appear to be a valid script.${NC}"
            exit 1
        fi

        if ! echo "$new_script" | grep -q "FADE_VERSION="; then
            echo -e "${RED}Error: Downloaded file does not appear to be a valid FADE script.${NC}"
            exit 1
        fi

        # Create backup
        local cli_backup_path="${fade_script}.bak"
        cp "$fade_script" "$cli_backup_path"

        # Write new script
        echo "$new_script" > "$fade_script"
        chmod +x "$fade_script"

        echo -e "${GREEN}✓ CLI updated: v$current_version → v$latest_version${NC}"
        echo -e "  Backup: $cli_backup_path"
        cli_updated=true
    fi

    echo ""

    # ========================================================================
    # PROMPT.MD UPDATE
    # ========================================================================

    # Determine prompt.md location (prefer fade/ if exists, fall back to root)
    local prompt_path=""
    if [[ -f "fade/prompt.md" ]]; then
        prompt_path="fade/prompt.md"
    elif [[ -f "prompt.md" ]]; then
        prompt_path="prompt.md"
    fi

    if [[ "$cli_only" == true ]]; then
        echo -e "${CYAN}Skipping prompt.md update (--cli-only flag)${NC}"
    elif [[ -z "$prompt_path" ]]; then
        echo -e "${YELLOW}No prompt.md found - skipping template update${NC}"
        echo "Run 'fade init' to create FADE structure with prompt.md"
    else
        echo -e "Checking $prompt_path..."

        # Fetch latest prompt.md template
        local latest_prompt
        latest_prompt=$(fetch_url "$FADE_PROMPT_URL")

        if [[ $? -ne 0 ]] || [[ -z "$latest_prompt" ]]; then
            echo -e "${YELLOW}Warning: Could not fetch prompt.md template from GitHub.${NC}"
            echo "Skipping prompt.md update."
        else
            # Compare with current prompt.md
            local current_prompt
            current_prompt=$(cat "$prompt_path")

            if [[ "$current_prompt" == "$latest_prompt" ]]; then
                echo -e "${GREEN}✓ $prompt_path already matches latest template${NC}"
            else
                echo -e "${YELLOW}$prompt_path differs from latest template${NC}"
                echo ""

                # Show diff summary
                echo -e "${BOLD}Changes summary:${NC}"
                echo ""

                # Create temp files for diff
                local temp_current=$(mktemp)
                local temp_latest=$(mktemp)
                echo "$current_prompt" > "$temp_current"
                echo "$latest_prompt" > "$temp_latest"

                # Show abbreviated diff stats
                local additions=$(diff "$temp_current" "$temp_latest" | grep -c '^>' || echo "0")
                local deletions=$(diff "$temp_current" "$temp_latest" | grep -c '^<' || echo "0")
                echo -e "  ${GREEN}+$additions${NC} additions, ${RED}-$deletions${NC} deletions"
                echo ""

                # Show first few changes as preview
                echo -e "${BOLD}Preview (first 10 changes):${NC}"
                diff "$temp_current" "$temp_latest" | head -20 | while IFS= read -r line; do
                    if [[ "$line" == ">"* ]]; then
                        echo -e "  ${GREEN}$line${NC}"
                    elif [[ "$line" == "<"* ]]; then
                        echo -e "  ${RED}$line${NC}"
                    else
                        echo "  $line"
                    fi
                done
                echo ""

                rm -f "$temp_current" "$temp_latest"

                # Ask for confirmation
                echo -e "${YELLOW}Update $prompt_path to latest template?${NC}"
                echo -e "This will backup your current prompt.md to ${prompt_path}.bak"
                echo ""
                read -p "Update $prompt_path? [y/N]: " confirm </dev/tty

                if [[ "$confirm" =~ ^[Yy]$ ]]; then
                    # Create backup
                    cp "$prompt_path" "${prompt_path}.bak"

                    # Write new prompt.md
                    echo "$latest_prompt" > "$prompt_path"

                    echo -e "${GREEN}✓ $prompt_path updated${NC}"
                    echo -e "  Backup: ${prompt_path}.bak"
                    prompt_updated=true
                else
                    echo -e "${CYAN}Skipped $prompt_path update${NC}"
                fi
            fi
        fi
    fi

    echo ""

    # ========================================================================
    # SUMMARY
    # ========================================================================

    if [[ "$cli_updated" == true ]] || [[ "$prompt_updated" == true ]]; then
        echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
        echo -e "${GREEN}✓ FADE update complete!${NC}"
        echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
        echo ""
        if [[ "$cli_updated" == true ]]; then
            echo -e "  CLI:       ${BOLD}v$current_version → v$latest_version${NC}"
        fi
        if [[ "$prompt_updated" == true ]]; then
            echo -e "  prompt.md: ${BOLD}updated to latest template${NC}"
        fi
        echo ""
    else
        echo -e "${GREEN}✓ Everything is up to date!${NC}"
    fi
}

# ============================================================================
# MAIN
# ============================================================================

case "${1:-}" in
    init)
        cmd_init
        ;;
    new)
        shift
        cmd_new "$@"
        ;;
    run)
        shift
        cmd_run "$@"
        ;;
    yolo)
        shift
        cmd_yolo "$@"
        ;;
    status)
        shift
        cmd_status "$@"
        ;;
    update)
        shift
        cmd_update "$@"
        ;;
    migrate)
        shift
        cmd_migrate "$@"
        ;;
    version|--version|-v)
        shift
        cmd_version "$@"
        ;;
    help|--help|-h)
        cmd_help
        ;;
    "")
        cmd_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo "Run 'fade help' for usage."
        exit 1
        ;;
esac
