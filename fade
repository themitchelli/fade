cmd_init() {
    echo -e "${CYAN}Initializing FADE structure...${NC}"
    echo ""

    local created=0

    create_file_if_missing "FADE.md" "$FADE_TEMPLATE" && ((created++)) || true
    create_file_if_missing "progress.md" "$PROGRESS_TEMPLATE" && ((created++)) || true
    create_file_if_missing "learned.md" "$LEARNED_TEMPLATE" && ((created++)) || true
    create_file_if_missing "prompt.md" "$PROMPT_TEMPLATE" && ((created++)) || true

    # Create prds/ folder
    if [[ ! -d "prds" ]]; then
        mkdir -p "prds"
        cat > "prds/README.md" << 'PRDS_EOF'
# PRDs Folder

Place your PRD files here using the naming convention:

```
{TYPE}-{NUMBER}-{slug}.json
```

## Examples

- `FEAT-001-user-authentication.json`
- `BUG-002-login-timeout.json`
- `CHORE-003-upgrade-dependencies.json`
- `ENH-004-improve-performance.json`
- `SPIKE-005-evaluate-caching.json`

## Selection Order

FADE picks the lowest-numbered PRD with incomplete stories.
Priority: prd.json (if exists) → prds/ folder (by number)
PRDS_EOF
        echo -e "  ${GREEN}create${NC}: prds/"
        ((created++))
    else
        echo -e "  ${YELLOW}skip${NC}: prds/ (already exists)"
    fi

    # Create prd-archive/ folder
    if [[ ! -d "prd-archive" ]]; then
        mkdir -p "prd-archive"
        touch "prd-archive/.gitkeep"
        echo -e "  ${GREEN}create${NC}: prd-archive/"
        ((created++))
    else
        echo -e "  ${YELLOW}skip${NC}: prd-archive/ (already exists)"
    fi

    echo ""
    if [[ $created -eq 0 ]]; then
        echo "No files created. FADE structure already exists."
    else
        echo -e "${GREEN}Created $created file(s).${NC}"
    fi
    
    echo ""
    echo "Next steps:"
    echo "  1. Edit FADE.md with your project context"
    echo "  2. Create a PRD in prds/ folder"
    echo "  3. Run 'fade run' to start working"
}

cmd_run() {
    local yolo_mode=false
    local quiet_mode=false

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --yolo)
                yolo_mode=true
                shift
                ;;
            --quiet|-q)
                quiet_mode=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    if [[ "$yolo_mode" == true ]]; then
        echo -e "${CYAN}FADE v$FADE_VERSION${NC} ${YELLOW}🤘 YOLO MODE${NC}"
    else
        echo -e "${CYAN}FADE v$FADE_VERSION${NC}"
    fi
    echo ""

    # Check for FADE files
    if [[ ! -f "FADE.md" ]]; then
        echo -e "${RED}Error: FADE.md not found. Run 'fade init' first.${NC}"
        exit 1
    fi

    # Display work queue
    if ! display_work_queue; then
        exit 0
    fi

    # Determine execution mode
    local mode
    if [[ "$yolo_mode" == true ]]; then
        mode="ALL"
        echo -e "${YELLOW}🤘 YOLO MODE - Skipping prompts, going straight to ALL mode${NC}"
    else
        mode=$(ask_execution_mode)
    fi

    echo ""
    echo -e "${GREEN}Starting in $mode mode...${NC}"
    echo ""

    # Set Claude command based on yolo mode
    local claude_cmd="claude"
    if [[ "$yolo_mode" == true ]]; then
        claude_cmd="claude --dangerously-skip-permissions"
    fi

    if [[ "$mode" == "STOP" ]]; then
        # STOP mode: single execution, hand over terminal completely
        local context=$(build_context)
        exec $claude_cmd "$context"
    else
        # ALL mode: loop until complete or blocked
        local iteration=1

        while true; do
            echo -e "${CYAN}────────────────────────────────────────────────────────────${NC}"
            echo -e "${CYAN}Iteration $iteration - Building fresh context...${NC}"
            echo -e "${CYAN}────────────────────────────────────────────────────────────${NC}"
            echo ""

            # Capture learned.md content before iteration (for change detection)
            local learned_before_file=$(mktemp)
            if [[ -f "learned.md" ]]; then
                cp learned.md "$learned_before_file"
            else
                touch "$learned_before_file"
            fi

            local context=$(build_context)

            # Run Claude and capture output
            local output_file=$(mktemp)

            # Run claude interactively but capture output
            $claude_cmd "$context" 2>&1 | tee "$output_file"
            local exit_code=${PIPESTATUS[0]}

            local output=$(cat "$output_file")
            rm -f "$output_file"

            # Check for signals in output
            if echo "$output" | grep -q "ALL_COMPLETE"; then
                rm -f "$learned_before_file"
                echo ""
                echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
                echo -e "${GREEN}🎉 ALL WORK COMPLETE!${NC}"
                echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
                echo ""

                # Archive completed PRDs
                echo -e "${YELLOW}Archiving completed PRDs...${NC}"

                # Archive prd.json if it exists and is complete
                local priority_output=$(archive_priority_prd)
                local priority_archived=$(echo "$priority_output" | tail -1)
                # Display archive message (all but last line which is the count)
                echo "$priority_output" | head -n -1

                # Archive completed PRDs from prds/ folder
                local archived_output=$(archive_completed_prds)
                local archived_count=$(echo "$archived_output" | tail -1)
                # Display archive messages (all but last line which is the count)
                echo "$archived_output" | head -n -1

                # Calculate total archived
                local total_archived=$((${priority_archived:-0} + ${archived_count:-0}))

                if [[ "$total_archived" -gt 0 ]]; then
                    echo -e "${GREEN}Archived $total_archived PRD(s) to prd-archive/${NC}"
                else
                    echo -e "  ${CYAN}No completed PRDs to archive${NC}"
                fi
                echo ""
                break
            fi

            if echo "$output" | grep -q "BLOCKED"; then
                rm -f "$learned_before_file"
                echo ""
                echo -e "${RED}════════════════════════════════════════════════════════════${NC}"
                echo -e "${RED}⛔ BLOCKED - Human intervention required${NC}"
                echo -e "${RED}════════════════════════════════════════════════════════════${NC}"
                break
            fi

            if echo "$output" | grep -q "STORY_DONE"; then
                # Extract story ID from STORY_DONE signal (format: STORY_DONE: US-XXX)
                local story_id=$(echo "$output" | grep -o 'STORY_DONE:[[:space:]]*[A-Z]*-[0-9]*' | head -1 | sed 's/STORY_DONE:[[:space:]]*//')

                # Display iteration summary (unless --quiet flag is set)
                if [[ "$quiet_mode" != true ]]; then
                    display_iteration_summary "$iteration" "$story_id" "$learned_before_file"
                fi

                rm -f "$learned_before_file"
                ((iteration++))
                sleep 2  # Brief pause for filesystem to settle
                continue
            fi

            # No recognized signal
            rm -f "$learned_before_file"
            echo ""
            echo -e "${YELLOW}════════════════════════════════════════════════════════════${NC}"
            echo -e "${YELLOW}⚠️  No exit signal detected. Stopping loop.${NC}"
            echo -e "${YELLOW}════════════════════════════════════════════════════════════${NC}"
            echo ""
            echo "Expected one of: STORY_DONE, ALL_COMPLETE, BLOCKED"
            echo "Check the output above for errors."
            break

        done
    fi
}

cmd_yolo() {
    # Convenience command: fade yolo is equivalent to fade run --yolo
    # Pass through any additional arguments (e.g., --quiet)
    cmd_run "--yolo" "$@"
